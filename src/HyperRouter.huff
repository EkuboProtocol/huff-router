/// @title HyperRouter
/// @author Die Herdplatte <https://github.com/die-herdplatte>
/// @notice A hyper gas-efficient, yet highly configurable, router for executing multiMultiHopSwaps on Ekubo pools

// Compiled with hnc 1.1.14 (rev: 4054da5c)

#define error SlippageCheckFailed(int128)

// TODO Core checks
// TODO Return delta(s) (?)

#define constant BITS_PER_BYTE = 0x8
#define constant BITS_PER_WORD = 0x100

#define constant MIN_SQRT_RATIO = 0x400065a8177fae27
#define constant MAX_SQRT_RATIO = 0xffff9a5889f795069a41a8a3

#define constant MINUS_ONE = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
#define constant ADDRESS_LENGTH = 0x14

// ILocker#locked(uint256 id) input offsets
#define constant LOCKED_FIRST_WORD_OFFSET = 0x27 // Includes the selector, locker ID, 2 bytes padding, and `withRecipient` (which isn't used in LOCKED())
#define constant LOCKED_CALCULATED_AMOUNT_THRESHOLD_OFFSET = 0x2e // Offset of the first dynamic piece of data

// ICore#swap_611415377(address token0, address token1, bytes32 config, int128 amount, bool isToken1, uint96 sqrtRatioLimit, uint256 skipAhead) and IFlashAccountant#forward (for MEV-resist) input offsets
#define constant SWAP_TOKEN0_OFFSET = 0x24
#define constant SWAP_TOKEN0_OFFSET_PACKED = 0x30
#define constant SWAP_TOKEN1_OFFSET = 0x44
#define constant SWAP_CONFIG_OFFSET = 0x64
#define constant SWAP_AMOUNT_OFFSET = 0x84
#define constant SWAP_IS_TOKEN1_OFFSET = 0xa4
#define constant SWAP_SQRT_RATIO_LIMIT_OFFSET = 0xc4
#define constant SWAP_SQRT_RATIO_LIMIT_PACKED_OFFSET = 0xd8
#define constant SWAP_SKIP_AHEAD_OFFSET = 0xe4

// ICore#swap_611415377(address token0, address token1, bytes32 config, int128 amount, bool isToken1, uint96 sqrtRatioLimit, uint256 skipAhead) and IFlashAccountant#forward (for MEV-resist) output offsets
#define constant SWAP_DELTA0_OFFSET = 0x30
#define constant SWAP_DELTA1_OFFSET = 0x50

// The lowest offset we don't touch while swapping (i.e. not counting the settlement phase)
#define constant MAX_ARGS_OFFSET = 0x104

// ICore#save(address owner, address token0, address token1, bytes32 salt, uint128 amount0, uint128 amount1) input offsets
#define constant SAVE_OWNER_PACKED_OFFSET = 0x10
#define constant SAVE_TOKEN0_OFFSET = 0x24
#define constant SAVE_AMOUNT0_OFFSET = 0x84
#define constant SAVE_AMOUNT1_OFFSET = 0x104
#define constant SAVE_ARGS_SIZE = 0xc4

// IFlashAccountant#withdraw(address token, address recipient, uint128 amount) input offsets
#define constant WITHDRAW_TOKEN_OFFSET = 0x4
#define constant WITHDRAW_RECIPIENT_PACKED_OFFSET = 0x30
#define constant WITHDRAW_AMOUNT_OFFSET = 0x44
#define constant WITHDRAW_ARGS_SIZE = 0x64

// IFlashAccountant#pay(address token) input offsets
#define constant PAY_TOKEN_OFFSET = 0x4
#define constant PAY_AMOUNT_OFFSET = 0x24
#define constant PAY_FROM_OFFSET = 0x44
#define constant PAY_ARGS_SIZE = 0x64

// IPayer#payCallback(uint256 id, address token) input offsets
#define constant PAY_CALLBACK_TOKEN_OFFSET = 0x24
#define constant PAY_CALLBACK_AMOUNT_OFFSET = 0x44
#define constant PAY_CALLBACK_FROM_OFFSET = 0x64

// IERC20#transfer(address to, uint256 amount) input offsets
#define constant TRANSFER_AMOUNT_OFFSET = 0x24
#define constant TRANSFER_ARGS_SIZE = 0x44

// IERC20#transferFrom(address from, address to, uint256 amount) input offsets
#define constant TRANSFER_FROM_FROM_OFFSET = 0x4
#define constant TRANSFER_FROM_TO_OFFSET = 0x24
#define constant TRANSFER_FROM_AMOUNT_OFFSET = 0x44
#define constant TRANSFER_FROM_ARGS_SIZE = 0x64

/*
 * ATTENTION: This is a volatile value and may change even on minor modifications.
 * The reason for that seems to be that hnc doesn't insert jump and code tables in
 * the order that they appear in the source file but their first usage.
 * As of now, this offset includes the TOKENS, SAVE_DATA, and TRANSFER_DATA code tables and all jump tables.
 */
#define constant ROUTER_ADDRESS_END_OFFSET = 0x878

#define macro CONSTRUCTOR() = {
    // Copy runtime code into memory
    __codesize(CONSTRUCTOR)                                                 // [constructorSize]
    codesize sub                                                            // [runtimeSize]
    address                                                                 // [address, runtimeSize]
    [ROUTER_ADDRESS_END_OFFSET] dup3 sub                                    // [routerAddressOffset, address, runtimeSize]
    dup3 __codesize(CONSTRUCTOR) 0x                                         // [memOffset, constructorSize, runtimeSize, routerAddressOffset, address, runtimeSize]
    codecopy                                                                // [routerAddressOffset, address, runtimeSize]

    // Write router address to runtime code
    mstore                                                                  // [runtimeSize]

    0x return
}

#define macro MAIN() = takes(0) returns(0) {
    0x calldataload dup1                                                    // [firstWord, firstWord]

    // Not only the function selector, but also the first 224 bits of the
    // arguments (which is the locker id and always zero in any practical case)
    __RIGHTPAD(__FUNC_SIG("locked(uint256)"))                               // [lockedFirstWord, firstWord, firstWord]

    eq lockedLbl jumpi                                                      // [firstWord]

    // Same approach for payCallback which also includes the locker id
    __RIGHTPAD(__FUNC_SIG("payCallback(uint256,address)"))                  // [payCallbackFirstWord, first]

    eq payCallbackLbl jumpi                                                 // []
        LOCK()
    lockedLbl:                                                              // [firstWord]
        pop                                                                 // []
        LOCKED()
    payCallbackLbl:                                                         // []
        PAY_CALLBACK()
}

/// @notice Entrypoint of the router which prepares and executes the call to IFlashAccountant#lock.
///
/// `withRecipient` (1 byte `bool`)
/// Whether the swap output (after possibly deducting integration fees) should be sent
/// to an address different from the caller.
///
/// `specifiedAmountBytes` (1 byte unsigned integer, <= 16)
/// The length of the `specifiedAmount`s of each multihop swap in bytes.
///
/// `calculatedAmountThresholdBytes` (1 byte `uint8`, <= 16)
/// The length of `calculatedAmountThreshold` in bytes.
///
/// `specifiedTokenInfo` (1 byte)
/// Describes the input token of the multihop swaps:
/// 0x00 - 0xfe := Token address stored at the given index in the `TOKENS` table
/// 0xff := Token address is passed in the calldata
///
/// `calculatedTokenInfo` (1 byte)
/// Analogous to `specifiedTokenInfo`.
///
/// `additionalMultiHopSwaps` (1 byte `uint8`)
/// How many more multihop swaps are encoded besides the mandotary one.
///
/// `withIntegrationFee` (1 byte `bool`)
/// Whether a share of the swap output will be distributed to a given integrator.
///
/// `withSqrtRatioLimit` | `isExactOut` (1 bit `bool` | 1 bit `bool`, left-padded)
/// Whether swaps are encoded with a custom sqrt ratio limit and
/// whether the swap is exact out.
///
/// `calculatedAmountThreshold` (variable length signed integer, up to 16 bytes)
/// How much the last swaps of each multiHopSwap need to return in total at minimum for the call to succeed.
///
/// `specifiedTokenAddress` (20 bytes `address`, optional as per `specifiedTokenInfo`)
/// The address of the input token of the multihop swaps.
///
/// `calculatedTokenAddress` (20 bytes `address`, optional as per `calculatedTokenInfo`)
/// Analogous to `specifiedTokenAddress`.
///
/// Per multihop swap:
///
/// `specifiedAmount` (variable length signed integer up to 16 bytes, determined by `specifiedAmountBytes`)
/// The specified amount of the first swap.
///
/// `additionalSwaps` (1 byte unsigned integer)
/// How many more swaps are encoded in this multihop swap besides the mandatory one.
///
/// Per swap:
///
/// `extensionInfo` (1 byte)
/// Describes the extension of this hop's pool:
/// 0x00 := Base extension
/// 0x01 := Oracle extension
/// 0x02 := TWAMM extension
/// 0x03 := MEV-resist extension
/// 0x04 := Pool config is passed in the calldata
///
/// `skipAhead` (1 byte `uint8`, optional as per `extensionInfo`)
/// For base, MEV-resist, and unknown extensions, this is an `uint8`. Otherwise non-existent.
///
/// `configInfo` (variable)
/// Depending on `extensionInfo`:
/// Base => fee (8 bytes) | tick spacing (4 bytes)
/// Oracle => empty
/// TWAMM => fee (8 bytes)
/// MEV-resist => fee (8 bytes) | tick spacing (4 bytes)
/// Else => complete config (32 bytes)
///
/// `tokenInfo` (1 byte, for all but the last swap in a multihop swap)
/// Describes the output token of this hop:
/// [0x00, 0xfe] := Token address stored at the given index in the `TOKENS` table
/// 0xff := Token address is passed in the calldata
///
/// `tokenAddress` (20 bytes `address`, optional as per `tokenInfo`, also for all but the last swap in a multihop swap)
/// The address of the output token of this hop.
///
/// `sqrtRatioLimit` (12 bytes `uint96`, optional as per `withSqrtRatioLimit`)
/// The price limit of the swap.
///
/// After the swap data:
///
/// `feeShare` | `feeRecipient` (2 bytes 0.16 fixed point number | 20 bytes `address`, optional as per `withIntegrationFee`)
/// The integrator address as well as the share that the integrator receives from the swap output.
/// Fees are `save`d for the `feeRecipient` in Core.
#define macro LOCK() = takes(0) returns(0) {
    // Load lock() selector and router address in one `codecopy`
    __tablesize(LOCK_SIG_AND_ROUTER_ADDRESS)                                // [tableSize]
    __tablestart(LOCK_SIG_AND_ROUTER_ADDRESS)                               // [tableStart, tableSize]
    0x codecopy                                                             // []
    0x4 mload                                                               // [routerAddress]

    // Load `withRecipient`
    0x calldataload 0x byte                                                 // [withRecipient, routerAddress]

    // If `withRecipient == true`, the recipient is already stored in the calldata
    withRecipientLbl jumpi                                                  // [routerAddress]
        caller                                                              // [caller, routerAddress]

        // Since the minimum `calldatasize` is 10 bytes (`withRecipient`, `specifiedAmountBytes`, `calculatedAmountThresholdBytes`,
        // `withIntegrationFee`, `specifiedTokenInfo`, `calculatedTokenInfo`, `additionalMultiHopSwaps`,
        // `withSqrtRatioLimit` | `isExactOut`, `additionalSwaps`, `extensionInfo`),
        // we designate 2 bytes between the selector and the calldata as padding to ensure never overwriting the selector.
        // Therefore, 4 bytes selector - 12 bytes packed `address` offset + 2 bytes padding = -6 bytes offset from `calldatasize`
        0x6 calldatasize sub                                                // [callerOffset, caller, routerAddress]
        mstore                                                              // [routerAddress]

        MAYBE_STORE_TRANSFER_FROM(0x1a, 0x3a)
    withRecipientLbl:                                                       // [routerAddress]
        MAYBE_STORE_TRANSFER_FROM(0x6, 0x26)
}

#define macro MAYBE_STORE_TRANSFER_FROM(additionalArgsSizeDelegate, additionalArgsSizeNoDelegate) = takes(1) returns(0) {
    // takes: [routerAddress]

    address eq noDelegateCallLbl jumpi                                      // []
        LOCK_END(<additionalArgsSizeDelegate>)
    noDelegateCallLbl:                                                      // []
        // Store ABI-encoded caller address after the end of the calldata
        caller <additionalArgsSizeDelegate> calldatasize add mstore         // []

        LOCK_END(<additionalArgsSizeNoDelegate>)
}

#define macro LOCK_END(additionalArgsSize) = takes(0) returns(0) {
    // Copy calldata unchanged after the selector and the 2 bytes of padding
    calldatasize 0x 0x6 calldatacopy                                        // []

    0x 0x                                                                   // [retOffset, retSize]
    calldatasize <additionalArgsSize> add                                   // [argsSize, retOffset, retSize]

    // IFlashAccountant#lock()
    0x 0x [CORE] gas call                                                   // [success]

    returndatasize 0x 0x returndatacopy                                     // [success]

    successLbl jumpi                                                        // []
        returndatasize 0x revert
    successLbl:                                                             // []
        returndatasize 0x return
}

/// @notice Ekubo Core callback, executing a multiMultiHopSwap.
///
/// In addition to the calldata passed to LOCK():
///
/// `swapRecipient` (20 bytes `address`, determined in LOCK())
/// Adress of the account that receives the swap output (after possibly deducting integration fees).
///
/// `transferFrom` (32 bytes ABI-encoded `address`, optional as determined in LOCK(), non-zero)
/// If this is called via a `delegatecall` (checked via `routerAddress != address(this)`), the
/// swap inputs are transferred from the delegating contract and this value does not exist.
/// Otherwise, approvals to this contract from the caller are consumed to settle the debt.
#define macro LOCKED() = takes(0) returns(0) {
    [LOCKED_FIRST_WORD_OFFSET] calldataload                                 // [firstWord]

    // Parse `specifiedAmountBytes`
    dup1 0x byte                                                            // [specifiedAmountBytes, firstWord]

    // Parse `calculatedAmountThresholdBytes` and compute `calculatedAmountThreshold`
    [LOCKED_CALCULATED_AMOUNT_THRESHOLD_OFFSET]                             // [offset, specifiedAmountBytes, firstWord]
    dup3 0x1 byte                                                           // [calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    dup2 calldataload dup2                                                  // [calculatedAmountThresholdBytes, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    [BITS_PER_BYTE] mul                                                     // [calculatedAmountThresholdBits, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    [BITS_PER_WORD] sub shr                                                 // [calculatedAmountThreshold, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    swap2                                                                   // [offset, calculatedAmountThresholdBytes, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    add                                                                     // [offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]

    // Parse `specifiedTokenInfo` and recover `specifiedToken`
    0x                                                                      // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup5 0x2 byte                                                           // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup1 0xff gt specifiedKnownLbl jumpi                                    // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        pop                                                                 // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [ADDRESS_LENGTH]                                                    // [addressLength, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        dup3 calldataload 0x60 shr                                          // [specifiedToken, addressLength, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap3                                                               // [offset, addressLength, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        add                                                                 // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        specifiedJoinLbl jump
    specifiedKnownLbl:                                                      // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        STORE_KNOWN_TOKEN_AT_TOKEN0_OFFSET()                                // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        LOAD_KNOWN_TOKEN_FROM_TOKEN0_OFFSET()                               // [specifiedToken, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap2                                                               // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    specifiedJoinLbl:                                                       // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]

    // Parse `calculatedTokenInfo` and recover `calculatedToken`
    0x                                                                      // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup7 0x3 byte                                                           // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup1 0xff gt calculatedKnownLbl jumpi                                   // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        pop                                                                 // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [ADDRESS_LENGTH]                                                    // [addressLength, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        dup3 calldataload 0x60 shr                                          // [calculatedToken, addressLength, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap3                                                               // [offset, addressLength, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        add                                                                 // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        calculatedJoinLbl jump
    calculatedKnownLbl:                                                     // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        STORE_KNOWN_TOKEN_AT_TOKEN0_OFFSET()                                // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        LOAD_KNOWN_TOKEN_FROM_TOKEN0_OFFSET()                               // [calculatedToken, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap2                                                               // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    calculatedJoinLbl:                                                      // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    swap7                                                                   // [firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `additionalMultiHopSwaps`
    dup1 0x4 byte 0x1 add                                                   // [remainingMultiHopSwaps, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `withIntegrationFee`
    dup2 0x5 byte                                                           // [withIntegrationFee, remainingMultiHopSwaps, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    swap2                                                                   // [firstWord, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `withSqrtRatioLimit | isExactOut`
    0x6 byte                                                                // [withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Load jumptable into memory & take jump
    __tablesize(CONFIG_TABLE) __tablestart(CONFIG_TABLE)                    // [tableStart, tableSize, withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x codecopy                                                             // [withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x20 mul mload jump                                                     // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    noSqrtRatioExactInLbl:                                                  // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
        __tablesize(EXTENSION0_TABLE) __tablestart(EXTENSION0_TABLE)        // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

        START_SWAPPING(NO_OP())

        baseExtension0Lbl:                                                  // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            BASE_EXTENSION(STORE_MIN_SQRT_RATIO(), STORE_MAX_SQRT_RATIO())
        oracleExtension0Lbl:                                                // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            ORACLE_EXTENSION(STORE_MIN_SQRT_RATIO(), STORE_MAX_SQRT_RATIO())
        twammExtension0Lbl:                                                 // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            TWAMM_EXTENSION(STORE_MIN_SQRT_RATIO(), STORE_MAX_SQRT_RATIO())
        mevResistExtension0Lbl:                                             // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            MEV_RESIST_EXTENSION(STORE_MIN_SQRT_RATIO(), STORE_MAX_SQRT_RATIO())
        unknownExtension0Lbl:                                               // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            UNKNOWN_EXTENSION(STORE_MIN_SQRT_RATIO(), STORE_MAX_SQRT_RATIO())
    noSqrtRatioExactOutLbl:
        __tablesize(EXTENSION1_TABLE) __tablestart(EXTENSION1_TABLE)        // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

        START_SWAPPING(NEG())

        baseExtension1Lbl:                                                  // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            BASE_EXTENSION(STORE_MAX_SQRT_RATIO(), STORE_MIN_SQRT_RATIO())
        oracleExtension1Lbl:                                                // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            ORACLE_EXTENSION(STORE_MAX_SQRT_RATIO(), STORE_MIN_SQRT_RATIO())
        twammExtension1Lbl:                                                 // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            TWAMM_EXTENSION(STORE_MAX_SQRT_RATIO(), STORE_MIN_SQRT_RATIO())
        mevResistExtension1Lbl:                                             // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            MEV_RESIST_EXTENSION(STORE_MAX_SQRT_RATIO(), STORE_MIN_SQRT_RATIO())
        unknownExtension1Lbl:                                               // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            UNKNOWN_EXTENSION(STORE_MAX_SQRT_RATIO(), STORE_MIN_SQRT_RATIO())
    withSqrtRatioExactInLbl:
        __tablesize(EXTENSION2_TABLE) __tablestart(EXTENSION2_TABLE)        // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

        START_SWAPPING(NO_OP())

        baseExtension2Lbl:                                                  // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            BASE_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
        oracleExtension2Lbl:                                                // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            ORACLE_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
        twammExtension2Lbl:                                                 // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            TWAMM_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
        mevResistExtension2Lbl:                                             // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            MEV_RESIST_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
        unknownExtension2Lbl:                                               // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            UNKNOWN_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
    withSqrtRatioExactOutLbl:
        __tablesize(EXTENSION3_TABLE) __tablestart(EXTENSION3_TABLE)        // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

        START_SWAPPING(NEG())

        baseExtension3Lbl:                                                  // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            BASE_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
        oracleExtension3Lbl:                                                // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            ORACLE_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
        twammExtension3Lbl:                                                 // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            TWAMM_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
        mevResistExtension3Lbl:                                             // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            MEV_RESIST_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
        unknownExtension3Lbl:                                               // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            UNKNOWN_EXTENSION(STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(), STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA())
}

#define macro STORE_KNOWN_TOKEN_AT_TOKEN0_OFFSET() = takes(1) returns(0) {
    // takes: [tokenId]
    [ADDRESS_LENGTH] mul                                                    // [tokenOffset]
    [ADDRESS_LENGTH] swap1                                                  // [tokenOffset, addressLength]
    __tablestart(TOKENS) add                                                // [tokenLocation, addressLength]

    // Save it at the offset of token0.
    // If the next swap is from token1 to token0 it already is stored at the right offset.
    [SWAP_TOKEN0_OFFSET_PACKED] codecopy                                    // []
}

#define macro LOAD_KNOWN_TOKEN_FROM_TOKEN0_OFFSET() = takes(0) returns(1) {
    [SWAP_TOKEN0_OFFSET] mload                                              // [token]
}

#define macro NO_OP() = takes(0) returns(0) {}

#define macro NEG() = takes(1) returns(1) {
    // takes: [number]
    0x sub                                                                  // [negated]
}

#define macro START_SWAPPING(specifiedSign) = takes(11) returns(13) {
    // takes: [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Copy the packed jump table to a destination that we know we won't override.
    [MAX_ARGS_OFFSET] codecopy                                              // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    dup6                                                                    // [nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    dup9 [BITS_PER_BYTE] mul                                                // [specifiedAmountBits, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    swap10                                                                  // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    multiHopLbl:                                                            // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        // Read and store `specifiedAmount` and add to `totalSpecified`
        dup1 calldataload                                                   // [specifiedAmountWord, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup12 [BITS_PER_WORD] sub shr                                       // [specifiedAmountUnsigned, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup1 <specifiedSign>                                                // [nextSpecifiedAmount, specifiedAmountUnsigned, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        swap8                                                               // [totalSpecified, specifiedAmountUnsigned, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        add                                                                 // [totalSpecified, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        swap1                                                               // [offset, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup11 add                                                           // [offset, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        // Read `additionalSwaps`
        dup1 calldataload 0x byte                                           // [additionalSwaps, offset, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        swap1                                                               // [offset, additionalSwaps, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x1 add                                                             // [offset, additionalSwaps, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        swap2                                                               // [totalSpecified, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        swap8                                                               // [nextSpecifiedAmount, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        singleHopLbl:                                                       // [nextSpecifiedAmount, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            // Store `amount`
            [SWAP_AMOUNT_OFFSET] mstore                                     // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            dup2 calldataload                                               // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            dup1 0x byte                                                    // [extensionInfo, swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            // Lookup in packed jump table
            0x2 mul [MAX_ARGS_OFFSET] add                                   // [jumpOffset, swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            mload 0xf0 shr jump                                             // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
}

#define macro BASE_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1) = takes(13) returns(0) {
    // takes: [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup1 0x12 shl 0xa0 shr [SWAP_CONFIG_OFFSET] mstore                      // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_SWAP_SELECTOR()                                                   // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    STORE_SKIP_AHEAD()                                                      // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    PARSE_TOKEN_STORE_ARGS_CALL_SWAP(
        0xe,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
    )
}

#define macro ORACLE_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1) = takes(13) returns(0) {
    // takes: [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    pop                                                                     // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    // Fee and tick spacing are zero
    __RIGHTPAD([ORACLE]) [SWAP_CONFIG_OFFSET] mstore                        // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_SWAP_SELECTOR()                                                   // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    PARSE_TOKEN_STORE_ARGS_CALL_SWAP(
        0x1,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
    )
}

#define macro TWAMM_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1) = takes(13) returns(0) {
    // takes: [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    0x98 shr 0xffffffffffffffff00000000 and                                 // [shiftedFee, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    __RIGHTPAD([TWAMM]) or [SWAP_CONFIG_OFFSET] mstore                      // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_SWAP_SELECTOR()                                                   // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    PARSE_TOKEN_STORE_ARGS_CALL_SWAP(
        0x9,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
    )
}

#define macro MEV_RESIST_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1) = takes(13) returns(0) {
    // takes: [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup1 0x12 shl 0xa0 shr                                                  // [configWithoutExtension, swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    __RIGHTPAD([MEV_RESIST]) or                                             // [config, swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [SWAP_CONFIG_OFFSET] mstore                                             // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    [MEV_RESIST] STORE_FORWARD_SELECTOR_AND_TO()                            // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    STORE_SKIP_AHEAD()                                                      // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    PARSE_TOKEN_STORE_ARGS_CALL_SWAP(
        0xe,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_FORWARD_CALL_OFFSET_AND_LENGTH(),
    )
}

#define macro UNKNOWN_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1) = takes(13) returns(0) {
    // takes: [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    0x20 dup4 0x2 add [SWAP_CONFIG_OFFSET] calldatacopy                     // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_SWAP_SELECTOR()                                                   // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    STORE_SKIP_AHEAD()                                                      // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    PARSE_TOKEN_STORE_ARGS_CALL_SWAP(
        0x22,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
    )
}

#define macro STORE_MIN_SQRT_RATIO() = takes(0) returns(0) {
    [MIN_SQRT_RATIO] [SWAP_SQRT_RATIO_LIMIT_OFFSET] mstore                  // []
}

#define macro STORE_MAX_SQRT_RATIO() = takes(0) returns(0) {
    [MAX_SQRT_RATIO] [SWAP_SQRT_RATIO_LIMIT_OFFSET] mstore                  // []
}

#define macro STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA() = takes(1) returns(1) {
    // takes: [offset]
    0xc dup2 [SWAP_SQRT_RATIO_LIMIT_PACKED_OFFSET] calldatacopy             // [offset]
    0xc add                                                                 // [offset]
}

#define macro STORE_SWAP_SELECTOR() = takes(0) returns(0) {
    0x 0x4 mstore                                                           // []
}

#define macro STORE_SKIP_AHEAD() = takes(1) returns(0) {
    // takes: [swapWord]
    0x1 byte                                                                // [skipAhead]
    [SWAP_SKIP_AHEAD_OFFSET] mstore                                         // []
}

#define macro STORE_FORWARD_SELECTOR_AND_TO() = takes(1) returns(0) {
    // takes: [to]
    __RIGHTPAD(__FUNC_SIG("forward(address)")) 0x mstore                    // [to]
    0x4 mstore                                                              // []
}

#define macro PUSH_SWAP_CALL_OFFSET_AND_LENGTH() = takes(0) returns(2) {
    0xe4 0x20                                                               // [argsOffset, argsSize]
}

#define macro PUSH_FORWARD_CALL_OFFSET_AND_LENGTH() = takes(0) returns(2) {
    0x104 0x                                                                // [argsOffset, argsSize]
}

#define macro PARSE_TOKEN_STORE_ARGS_CALL_SWAP(tokenInfoOffset, sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, callArgs) = takes(12) returns(0) {
    // takes: [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup1 notLastSwapLbl jumpi                                               // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        pop                                                                 // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <tokenInfoOffset> add                                               // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup6                                                                // [nextCalculatedToken, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        STORE_ARGS_CALL_SWAP_LAST(
            <sqrtRatioLimitIsToken0>,
            <sqrtRatioLimitIsToken1>,
            <callArgs>,
        )
    notLastSwapLbl:                                                         // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [MINUS_ONE] add                                                     // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        swap1                                                               // [offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <tokenInfoOffset> add                                               // [offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        dup1 calldataload 0x byte                                           // [tokenInfo, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        dup1 0xff gt knownTokenLbl jumpi                                    // [tokenInfo, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            pop                                                             // [offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            0x15 add                                                        // [offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            [ADDRESS_LENGTH] dup2 sub calldataload 0x60 shr                 // [nextCalculatedToken, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            STORE_ARGS_CALL_SWAP_NOT_LAST(
                TOKEN0_NOT_IN_MEMORY(),
                <sqrtRatioLimitIsToken0>,
                <sqrtRatioLimitIsToken1>,
                <callArgs>,
            )
        knownTokenLbl:                                                      // [tokenInfo, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            STORE_KNOWN_TOKEN_AT_TOKEN0_OFFSET()                            // [offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            0x1 add                                                         // [offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            LOAD_KNOWN_TOKEN_FROM_TOKEN0_OFFSET()                           // [nextCalculatedToken, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            STORE_ARGS_CALL_SWAP_NOT_LAST(
                NO_OP(),
                <sqrtRatioLimitIsToken0>,
                <sqrtRatioLimitIsToken1>,
                <callArgs>,
            )
}

#define macro TOKEN0_NOT_IN_MEMORY() = takes(3) returns(3) {
    // takes: [offset, additionalSwaps, nextCalculatedToken]
    dup3 [SWAP_TOKEN0_OFFSET] mstore                                        // [offset, additionalSwaps, nextCalculatedToken]
}

#define macro STORE_ARGS_CALL_SWAP_LAST(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, callArgs) = takes(12) returns(0) {
    // takes: [nextCalculatedToken, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup9                                                                    // [specifiedToken, nextCalculatedToken, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    swap3                                                                   // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    dup1 dup3                                                               // [nextCalculatedToken, nextSpecifiedToken, nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    lt isToken1Lbl jumpi                                                    // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN0_OFFSET] mstore                                         // [nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN1_OFFSET] mstore                                         // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <sqrtRatioLimitIsToken0>                                            // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x [SWAP_IS_TOKEN1_OFFSET] mstore                                   // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        CALL_SWAP(<callArgs>)                                               // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        LAST_SWAP_IN_MULTI_HOP(SWAP_DELTA1_OFFSET)
    isToken1Lbl:                                                            // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN1_OFFSET] mstore                                         // [nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN0_OFFSET] mstore                                         // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <sqrtRatioLimitIsToken1>                                            // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x1 [SWAP_IS_TOKEN1_OFFSET] mstore                                  // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        CALL_SWAP(<callArgs>)                                               // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        LAST_SWAP_IN_MULTI_HOP(SWAP_DELTA0_OFFSET)
}

#define macro CALL_SWAP(callArgs) = takes(0) returns(0) {
    // delta0 and delta1
    0x40                                                                    // [retSize]

    // Override only the non-zero address part of token0 because we don't clear it in the case that the next token is `codecopy`d.
    // We're also overriding the complete token1 and parts of the config offsets, but we always write to the full slot in the next iteration.
    [SWAP_TOKEN0_OFFSET_PACKED]                                             // [retOffset, retSize]

    <callArgs>                                                              // [argsOffset, argsSize, retOffset, retSize]

    // ICore#swap_611415377(address token0, address token1, bytes32 config, int128 amount, bool isToken1, uint96 sqrtRatioLimit, uint256 skipAhead) or IFlashAccountant#forward
    0x [CORE] gas call                                                      // [success]
    pop                                                                     // []
}

// TODO: FOR EXACT-IN ONLY
#define macro LAST_SWAP_IN_MULTI_HOP(deltaOffset) = takes(11) returns(0) {
    // takes: [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    // Add to `totalCalculated`
    swap4 <deltaOffset> mload swap1                                         // [totalCalculated, swapCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    sub swap4                                                               // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    // Decrement `remainingMultiHopSwaps`
    swap2 0x1 sub swap2                                                     // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup3 multiHopLbl jumpi                                                  // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    swap8                                                                   // [calculatedAmountThreshold, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    dup5 lt slippageCheckFailedLbl jumpi                                    // [specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    pop pop                                                                 // [withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    iszero withoutIntegrationFeeLbl jumpi                                   // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup5 calldataload 0xf0 shr                                          // [feeShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        dup2 mul 0x10 shr                                                   // [integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup1                                                                // [integratorShare, integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        // Store arguments

        __tablesize(SAVE_DATA) __tablestart(SAVE_DATA) 0x codecopy          // [integratorShare, integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        [ADDRESS_LENGTH]                                                    // [addressLength, integratorShare, integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup8 0x2 add                                                        // [integratorOffset, addressLength, integratorShare, integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        [SAVE_OWNER_PACKED_OFFSET] calldatacopy                             // [integratorShare, integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        dup2 [SAVE_TOKEN0_OFFSET] mstore                                    // [integratorShare, integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        [SAVE_AMOUNT0_OFFSET] mstore                                        // [integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        0x [SAVE_AMOUNT1_OFFSET] mstore                                     // [integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        // ICore#save(address owner, address token0, address token1, bytes32 salt, uint128 amount0, uint128 amount1)
        0x 0x [SAVE_ARGS_SIZE] 0x 0x [CORE] gas call                        // [success, integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        pop                                                                 // [integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        // Update offset
        swap5 0x16 add swap5                                                // [integratorShare, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        swap1 sub                                                           // [remainingCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    withoutIntegrationFeeLbl:                                               // [remainingCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    __RIGHTPAD(__FUNC_SIG("withdraw(address,address,uint128)")) 0x mstore   // [remainingCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    [WITHDRAW_AMOUNT_OFFSET] mstore                                         // [calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    [WITHDRAW_TOKEN_OFFSET] mstore                                          // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    [ADDRESS_LENGTH] dup4 [WITHDRAW_RECIPIENT_PACKED_OFFSET] calldatacopy   // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    // ICore#withdraw(address token, address recipient, uint128 amount)
    0x 0x [WITHDRAW_ARGS_SIZE] 0x 0x [CORE] gas call                        // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    pop                                                                     // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    dup2 erc20Lbl jumpi                                                     // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        // Transfer native token to Core
        0x 0x 0x 0x swap4 [CORE] gas call                                   // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        stop
    erc20Lbl:                                                               // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    __RIGHTPAD(__FUNC_SIG("pay(address)")) 0x mstore                        // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    [PAY_AMOUNT_OFFSET] mstore                                              // [specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    [PAY_TOKEN_OFFSET] mstore                                               // [offset, specifiedAmountBytes, specifiedAmountBits]

    // Move offset to `transferFrom` & load and store it
    [ADDRESS_LENGTH] add                                                    // [offset, specifiedAmountBytes, specifiedAmountBits]
    calldataload                                                            // [transferFrom, specifiedAmountBytes, specifiedAmountBits]
    [PAY_FROM_OFFSET] mstore                                                // [specifiedAmountBytes, specifiedAmountBits]

    // IFlashAccountant#pay(address token)
    0x 0x [PAY_ARGS_SIZE] 0x 0x [CORE] gas call                             // [success, specifiedAmountBytes, specifiedAmountBits]
    stop

    slippageCheckFailedLbl:                                                 // [withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    pop                                                                     // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    __ERROR(SlippageCheckFailed) 0x mstore                                  // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    0x4 mstore                                                              // [calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    0x24 0x revert
}

#define macro STORE_ARGS_CALL_SWAP_NOT_LAST(storeToken0, sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, callArgs) = takes(13) returns(0) {
    // takes: [nextCalculatedToken, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    swap3                                                                   // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    dup1 dup5                                                               // [nextCalculatedToken, nextSpecifiedToken, nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    lt isToken1Lbl jumpi                                                    // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN0_OFFSET] mstore                                         // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup3 [SWAP_TOKEN1_OFFSET] mstore                                    // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <sqrtRatioLimitIsToken0>                                            // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x [SWAP_IS_TOKEN1_OFFSET] mstore                                   // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        CALL_SWAP(<callArgs>)                                               // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        JUMP_TO_NEXT_HOP(SWAP_DELTA1_OFFSET)
    isToken1Lbl:                                                            // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN1_OFFSET] mstore                                         // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <storeToken0>                                                       // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <sqrtRatioLimitIsToken1>                                            // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x1 [SWAP_IS_TOKEN1_OFFSET] mstore                                  // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        CALL_SWAP(<callArgs>)                                               // [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        JUMP_TO_NEXT_HOP(SWAP_DELTA0_OFFSET)
}

#define macro JUMP_TO_NEXT_HOP(deltaOffset) = takes(12) returns(0) {
    // takes: [offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    swap1                                                               // [additionalSwaps, offset, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    // Negate the delta
    <deltaOffset> mload 0x sub                                          // [nextSpecifiedAmount, additionalSwaps, offset, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    singleHopLbl jump
}

/// @notice Ekubo Core pay callback, settling debt of an ERC-20 token with Core.
///
/// `token` (32 bytes ABI-encoded `address`)
/// The ERC-20 token for which to settle debt.
///
/// `amount` (32 bytes ABI-encoded `uint128`)
/// The amount to pay to Core.
///
/// `from` (32 bytes ABI-encoded `address`)
/// From which address to transfer the funds.
/// Uses ERC-20's approval mechanism for non-zero addresses
/// and transfers from self if the address is zero.
#define macro PAY_CALLBACK() = takes(0) returns(0) {
    [PAY_CALLBACK_FROM_OFFSET] calldataload                                 // [from]
    dup1 transferFromLbl jumpi                                              // [from]
        pop                                                                 // []

        __tablesize(TRANSFER_DATA) __tablestart(TRANSFER_DATA) 0x           // [memOffset, tablestart, tablesize]
        codecopy                                                            // []

        [PAY_CALLBACK_AMOUNT_OFFSET] calldataload                           // [amount]
        [TRANSFER_AMOUNT_OFFSET] mstore                                     // []

        // IERC20#transfer(address to, uint256 amount)
        0x 0x [TRANSFER_ARGS_SIZE] 0x 0x                                    // [value, argsOffset, argsSize, retOffset, retSize]
        [PAY_CALLBACK_TOKEN_OFFSET] calldataload                            // [token, value, argsOffset, argsSize, retOffset, retSize]
        gas call                                                            // [success]

        stop
    transferFromLbl:                                                        // [from]
        __RIGHTPAD(__FUNC_SIG("transferFrom(address,address,uint256)"))     // [selector, from]
        0x mstore                                                           // [from]
        [TRANSFER_FROM_FROM_OFFSET] mstore                                  // []
        [CORE] [TRANSFER_FROM_TO_OFFSET] mstore                             // []

        [PAY_CALLBACK_AMOUNT_OFFSET] calldataload                           // [amount]
        [TRANSFER_FROM_AMOUNT_OFFSET] mstore                                // []

        // IERC20#transferFrom(address from, address to, uint256 amount)
        0x 0x [TRANSFER_FROM_ARGS_SIZE] 0x 0x                               // [value, argsOffset, argsSize, retOffset, retSize]
        [PAY_CALLBACK_TOKEN_OFFSET] calldataload                            // [token, value, argsOffset, argsSize, retOffset, retSize]
        gas call                                                            // [success]

        stop
}

#define table LOCK_SIG_AND_ROUTER_ADDRESS {
    __FUNC_SIG("lock()")
    __LEFTPAD(0x) // Will be replaced with the ABI-encoded address of this contract in the constructor
}

#define table SAVE_DATA {
    __FUNC_SIG("save(address,address,address,bytes32,uint128,uint128)")     // selector
    __LEFTPAD(0x)                                                           // owner (will be filled in)
    __LEFTPAD(0x)                                                           // token0 (will be filled in)
    __LEFTPAD(0xffffffffffffffffffffffffffffffffffffffff)                   // token1 (the highest address possible, such that token0 will always be valid)
    0x20f590376094779f18e2fad85b75f8dcaf255b05ab4790b9c83b8245e9185211      // salt (keccak("HYPER_ROUTER"))
}

#define table TRANSFER_DATA {
    __FUNC_SIG("transfer(address,uint256)")
    __LEFTPAD([CORE])
}

