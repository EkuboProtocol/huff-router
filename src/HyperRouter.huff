#define constant BITS_PER_BYTE = 0x8
#define constant BITS_PER_WORD = 0x100

#define constant LOCK_CALLDATA_OFFSET = 0x4

#define constant LOCKED_CALLDATA_OFFSET = 0x24
#define constant CALCULATED_AMOUNT_THRESHOLD_OFFSET = 0x3c

#define macro MAIN() = takes(0) returns(0) {
    0x calldataload                                         // [firstWord]

    // Not only the function selector, but also the first 224 bits of the arguments (which is the locker id and always zero in any practical case)
    __RIGHTPAD(__FUNC_SIG("locked(uint256)"))               // [lockedFirstWord, firstWord]

    eq lockedJump jumpi                                     // []

    // Same approach for payCallback which also includes the locker id
    __RIGHTPAD(__FUNC_SIG("payCallback(uint256, address)"))

    eq payCallbackJump jumpi                                // []
        LOCK()
    lockedJump:                                             // []
        LOCKED()
    payCallbackJump:                                        // []
        PAY_CALLBACK()
}

#define macro LOCK() = takes(0) returns(0) {
    __RIGHTPAD(__FUNC_SIG("lock()")) 0x mstore              // []

    // Pass on the calldata unchanged
    calldatasize 0x [LOCK_CALLDATA_OFFSET] calldatacopy     // []

    // Call Core#lock()
    0x 0x                                                   // [retOffset, retSize]
    calldatasize [LOCK_CALLDATA_OFFSET] add                 // [argsSize, retOffset, retSize]
    0x 0x [CORE_ADDRESS] gas call                           // [success]

    returndatasize 0x 0x returndatacopy                     // [success]

    successJump jumpi                                       // []
        revert
    successJump:                                            // []
        returndatasize 0x return
}

/// @notice Ekubo Core callback, executing multi-multi-swaps
///
/// `specifiedToken` (20 bytes address)
/// The specified token for the first swaps of each multihop swap
///
/// `specifiedAmountBytes` (1 byte unsigned integer)
/// The length of the `specifiedAmount`s of each multihop swap in bytes
///
/// `calculatedAmountThresholdBytes` (1 byte unsigned integer)
/// The length of `calculatedAmountThreshold` in bytes
///
/// `additionalMultiHopSwaps` (1 byte unsigned integer)
/// How many more multihop swaps are encoded besides the mandotary one
///
/// `withSqrtRatioLimit` (1 byte boolean)
/// Whether swaps are encoded with a custom sqrt ratio limit
///
/// `calculatedAmountThreshold` (variable length signed integer, up to 16 bytes, non-zero)
/// How much the last swaps needs to return at minimum for the call to succeed
///
/// Per multihop swap:
///
/// `specifiedAmount` (variable length signed integer, up to 16 bytes)
/// The specified amount of the first swap
///
/// `additionalSwaps` (1 byte unsigned integer)
/// How many more swaps are encoded in this multihop swap besides the mandatory one
///
/// Per swap:
///
/// `token` (20 bytes address)
/// The output token of this swap
///
/// `poolConfig` (32 bytes)
/// The full pool config (fee, tick spacing, extension)
///
/// After the swap data:
///
/// `recipient` (`address`, optional)
#define macro LOCKED() = takes(0) returns(0) {
    // Push the values required for parsing the header
    [LOCKED_CALLDATA_OFFSET] calldataload                   // [firstWord]
    dup1 dup1 dup1                                          // [firstWord, firstWord, firstWord, firstWord]
    [CALCULATED_AMOUNT_THRESHOLD_OFFSET] calldataload       // [calculatedAmountThresholdWord, firstWord, firstWord, firstWord, firstWord]
    dup2                                                    // [firstWord, calculatedAmountThresholdWord, firstWord, firstWord, firstWord, firstWord]

    // Parse `specifiedToken`
    0x60 shr swap4                                          // [firstWord, calculatedAmountThresholdWord, firstWord, firstWord, specifiedToken, firstWord]

    // Parse `specifiedAmountBytes`
    0x14 byte swap5                                         // [firstWord, calculatedAmountThresholdWord, firstWord, firstWord, specifiedToken, specifiedAmountBytes]

    // Parse `calculatedAmountThresholdBytes`
    0x15 byte swap2                                         // [firstWord, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, firstWord, specifiedToken, specifiedAmountBytes]

    // Parse `additionalMultiHopSwaps`
    0x16 byte swap3                                         // [firstWord, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, additionalMultiHopSwaps, specifiedToken, specifiedAmountBytes]

    // Parse `withSqrtRatioLimit` and branch out
    0x17 byte                                               // [withSqrtRatioLimit, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, additionalMultiHopSwaps, specifiedToken, specifiedAmountBytes]
    withSqrtRatioLimitJump jumpi                            // [calculatedAmountThresholdWord, calculatedAmountThresholdBytes, additionalMultiHopSwaps, specifiedToken, specifiedAmountBytes]
        FINISH_PARSING()
    withSqrtRatioLimitJump:                                 // [calculatedAmountThresholdWord, calculatedAmountThresholdBytes, additionalMultiHopSwaps, specifiedToken, specifiedAmountBytes]
        FINISH_PARSING()
}

#define macro FINISH_PARSING() = takes(5) returns (0) {
    // takes: [calculatedAmountThresholdWord, calculatedAmountThresholdBytes, additionalMultiHopSwaps, specifiedToken, specifiedAmountBytes]

    // Recover `calculatedAmountThreshold`
    dup2 [BITS_PER_BYTE] mul                                // [calculatedAmountThresholdBits, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, additionalMultiHopSwaps, specifiedToken, specifiedAmountBytes]
    [BITS_PER_WORD] sub shr                                 // [calculatedAmountThresholdRaw, calculatedAmountThresholdBytes, additionalMultiHopSwaps, specifiedToken, specifiedAmountBytes]
    0x1 dup3 sub signextend                                 // [calculatedAmountThreshold, calculatedAmountThresholdBytes, additionalMultiHopSwaps, specifiedToken, specifiedAmountBytes]

    // Determine whether swap is exact-out from `calculatedAmountThreshold` sign
    dup1 0x sgt exactOutJump jumpi

    exactOutJump:

}

#define macro PAY_CALLBACK() = takes(0) returns(0) {

}
