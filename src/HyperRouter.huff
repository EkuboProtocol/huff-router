// FIXME Probably doesn't work
// NOTE: This must be the last code because we're using that `codecopy` substitutes out-of-bounds code areas with zeroes
#define table SAVE_DATA {
    __FUNC_SIG("save(address,address,address,bytes32,uint128,uint128)")     // selector
    __LEFTPAD(0x)                                                           // owner (will be filled in)
    __LEFTPAD(0x)                                                           // token0 (will be filled in)
    __LEFTPAD(0xffffffffffffffffffffffffffffffffffffffff)                   // token1 (the highest address possible, such that token0 will always be valid)
    0x20f590376094779f18e2fad85b75f8dcaf255b05ab4790b9c83b8245e9185211      // salt (keccak("HYPER_ROUTER"))
}
