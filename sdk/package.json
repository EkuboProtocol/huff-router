{
  "name": "@ekubo/evm-hyper-router-sdk",
  "version": "0.2.2",
  "description": "Calldata generation for Ekubo's gas-efficient and highly configurable HuffRouter smart contract",
  "type": "module",
  "main": "dist/index.cjs",
  "files": [
    "dist"
  ],
  "keywords": [
    "ekubo",
    "amm",
    "dex",
    "ethereum",
    "evm",
    "defi",
    "finance",
    "crypto",
    "blockchain",
    "smart-contracts"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --minify --tsconfig src/tsconfig.build.json",
    "find-approval-drain-losses": "tsx scripts/find-approval-drain-losses.ts",
    "test": "vitest",
    "generate-testdata": "wagmi generate 2>/dev/null && tsx test/generate-testdata.ts",
    "prepublishOnly": "rm -rf dist/ && npm run build",
    "update-token-lists": "tsx scripts/update-token-lists.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@wagmi/cli": "^2.3.2",
    "ts-essentials": "^10.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "viem": "^2.33.0"
  }
}
