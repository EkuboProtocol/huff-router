/* Size constants */
#define constant FEE_SHARE_SIZE = 0x2
#define constant INTEGRATION_FEE_SIZE = [FEE_SHARE_SIZE] + [ADDRESS_SIZE]
#define constant ADDRESS_PLUS_INTEGRATION_FEE_SIZE = [ADDRESS_SIZE] + [INTEGRATION_FEE_SIZE]

/* Protocol constants */
#define constant SQRT_RATIO_SIZE = 0xc

#define constant MIN_SQRT_RATIO = 0x00000000400065a8177fae27 // Must be exactly `SQRT_RATIO_SIZE` bytes wide
#define constant MAX_SQRT_RATIO = 0xffff9a5889f795069a41a8a3

#define constant TWO_POW_31 = 0x80000000
#define constant TWO_POW_160 = 0x10000000000000000000000000000000000000000

#define constant MIN_SQRT_RATIO_IS_TOKEN1_SWAP_ARGS = [MIN_SQRT_RATIO] * [TWO_POW_160] + [TWO_POW_31]
#define constant MAX_SQRT_RATIO_IS_TOKEN1_SWAP_ARGS = [MAX_SQRT_RATIO] * [TWO_POW_160] + [TWO_POW_31]

/* Calldata lengths of supported hop types */
#define constant HOP_TYPE_DISCRIMINATOR_SIZE = 0x1
#define constant SKIP_AHEAD_SIZE = 0x1
#define constant EXTENSION_SIZE = [ADDRESS_SIZE]
#define constant FEE_SIZE = 0x8
#define constant POOL_TYPE_CONFIG_SIZE = 0x4
#define constant CALL_TYPE_SIZE = 0x1

#define constant BASE_EXTENSION_CALLDATA_LENGTH = [HOP_TYPE_DISCRIMINATOR_SIZE] + [SKIP_AHEAD_SIZE] + [FEE_SIZE] + [POOL_TYPE_CONFIG_SIZE]
#define constant ORACLE_EXTENSION_CALLDATA_LENGTH = [HOP_TYPE_DISCRIMINATOR_SIZE]
#define constant TWAMM_EXTENSION_CALLDATA_LENGTH = [HOP_TYPE_DISCRIMINATOR_SIZE] + [FEE_SIZE]
#define constant MEV_CAPTURE_EXTENSION_CALLDATA_LENGTH = [HOP_TYPE_DISCRIMINATOR_SIZE] + [SKIP_AHEAD_SIZE] + [FEE_SIZE] + [POOL_TYPE_CONFIG_SIZE]
#define constant UNKNOWN_EXTENSION_CALLDATA_LENGTH = [HOP_TYPE_DISCRIMINATOR_SIZE] + [SKIP_AHEAD_SIZE] + [EXTENSION_SIZE] + [FEE_SIZE] + [POOL_TYPE_CONFIG_SIZE]
#define constant WRAPPED_TOKEN_CALLDATA_LENGTH = [HOP_TYPE_DISCRIMINATOR_SIZE] + [CALL_TYPE_SIZE]

/* ILocker#locked_6416899205(uint256 id) */
#define constant LOCKER_ID_SIZE = [WORD_SIZE]
#define constant LOCKED_SWAP_FIRST_WORD_OFFSET = [SELECTOR_SIZE] + [LOCKER_ID_SIZE] + [PADDING] + [WITH_RECIPIENT_SIZE] // `withRecipient` isn't used inside the lock

// First dynamic data
#define constant LOCKED_SWAP_CALCULATED_AMOUNT_THRESHOLD_OFFSET = [LOCKED_SWAP_FIRST_WORD_OFFSET] + [SPECIFIED_AMOUNT_BYTES_SIZE]
    + [CALCULATED_AMOUNT_THRESHOLD_BYTES_SIZE] + [SPECIFIED_TOKEN_INFO_SIZE] + [CALCULATED_TOKEN_INFO_SIZE]
    + [ADDITIONAL_MULTI_HOPS_SIZE] + [WITH_INTEGRATION_FEE_SIZE] + [WITH_SQRT_RATIO_LIMIT_IS_EXACT_OUT_SIZE]

/* IFlashAccountant#forward(address to) */
#define constant FORWARD_SELECTOR = __FUNC_SIG("forward(address)")
#define constant FORWARD_SELECTOR_PACKED = __RIGHTPAD([FORWARD_SELECTOR])

/* IFlashAccountant#forward(address to) (for MEV-capture) */
#define constant FORWARD_SELECTOR_OFFSET_PACKED = 0x
#define constant FORWARD_TO_OFFSET = [FORWARD_SELECTOR_OFFSET_PACKED] + [SELECTOR_SIZE]
#define constant FORWARD_TO_OFFSET_PACKED = [FORWARD_TO_OFFSET] + [PACKED_ADDRESS_OFFSET]
#define constant FORWARD_ARGS_SIZE = [SWAP_FORWARD_PARAMS_OFFSET] + [WORD_SIZE] - [FORWARD_SELECTOR_OFFSET_PACKED]

/* ICore#swap_6269342730() */
#define constant SWAP_SELECTOR = 0x // cast sig "swap_6269342730()" is zero
#define constant SWAP_SELECTOR_OFFSET = [SWAP_FORWARD_ARGS_OFFSET] - [WORD_SIZE]
#define constant SWAP_SELECTOR_OFFSET_PACKED = [SWAP_SELECTOR_OFFSET] + [PACKED_SELECTOR_OFFSET]
#define constant SWAP_ARGS_SIZE = [SWAP_FORWARD_PARAMS_OFFSET] + [WORD_SIZE] - [SWAP_SELECTOR_OFFSET_PACKED]

/* ICore#swap_6269342730() and IFlashAccountant#forward(address to) (for MEV-capture) */
#define constant SWAP_FORWARD_ARGS_OFFSET = [FORWARD_TO_OFFSET] + [WORD_SIZE] // Use a common offset for swaps through Core and MEV-capture

#define constant SWAP_FORWARD_TOKEN0_OFFSET = [SWAP_FORWARD_ARGS_OFFSET]
#define constant SWAP_FORWARD_TOKEN0_OFFSET_PACKED = [SWAP_FORWARD_TOKEN0_OFFSET] + [PACKED_ADDRESS_OFFSET]
#define constant SWAP_FORWARD_TOKEN1_OFFSET = [SWAP_FORWARD_TOKEN0_OFFSET] + [WORD_SIZE]
#define constant SWAP_FORWARD_CONFIG_OFFSET = [SWAP_FORWARD_TOKEN1_OFFSET] + [WORD_SIZE]
#define constant SWAP_FORWARD_PARAMS_OFFSET = [SWAP_FORWARD_CONFIG_OFFSET] + [WORD_SIZE]
#define constant SWAP_FORWARD_SQRT_RATIO_LIMIT_OFFSET_PACKED = [SWAP_FORWARD_PARAMS_OFFSET]
#define constant SWAP_FORWARD_IS_TOKEN1_OFFSET_PACKED = [SWAP_FORWARD_PARAMS_OFFSET] + [SQRT_RATIO_SIZE] + [HALFWORD_SIZE]

#define constant SWAP_FORWARD_RETURN_OFFSET = [SWAP_FORWARD_TOKEN0_OFFSET_PACKED] // Offset that doesn't override the upper bits of token0
#define constant SWAP_FORWARD_DELTA0_OFFSET = [SWAP_FORWARD_RETURN_OFFSET] - 0x10
#define constant SWAP_FORWARD_DELTA1_OFFSET = [SWAP_FORWARD_RETURN_OFFSET]
#define constant SWAP_FORWARD_RETURN_SIZE = 0x20

/* IFlashAccountant#forward(address to) (for wrapped tokens) */
#define constant WRAPPED_TOKEN_SELECTOR = __FUNC_SIG("forward(address)") // FIXME duplicate but hnc bug
#define constant WRAPPED_TOKEN_SELECTOR_OFFSET = [SWAP_FORWARD_TOKEN0_OFFSET_PACKED] - [PACKED_ADDRESS_OFFSET] // Offset that doesn't override the upper bits of token0
#define constant WRAPPED_TOKEN_SELECTOR_OFFSET_PACKED = [WRAPPED_TOKEN_SELECTOR_OFFSET] + [PACKED_SELECTOR_OFFSET]
#define constant WRAPPED_TOKEN_TO_OFFSET = [WRAPPED_TOKEN_SELECTOR_OFFSET] + [WORD_SIZE]
#define constant WRAPPED_TOKEN_AMOUNT_OFFSET = [WRAPPED_TOKEN_TO_OFFSET] + [WORD_SIZE]
#define constant WRAPPED_TOKEN_ARGS_SIZE = [WRAPPED_TOKEN_AMOUNT_OFFSET] + [WORD_SIZE] - [WRAPPED_TOKEN_SELECTOR_OFFSET_PACKED]

// The lowest offset we don't write to while swapping (i.e. not counting the settlement phase)
#define constant MAX_ARGS_OFFSET = [SWAP_FORWARD_PARAMS_OFFSET] + [WORD_SIZE]

/* ICore#updateSavedBalances(address token0, address token1, bytes32 salt, uint128 amount0, uint128 amount1) */
#define constant SAVE_SELECTOR_OFFSET_PACKED = 0x
#define constant SAVE_TOKEN0_OFFSET = [SAVE_SELECTOR_OFFSET_PACKED] + [SELECTOR_SIZE]
#define constant SAVE_TOKEN1_OFFSET = [SAVE_TOKEN0_OFFSET] + [WORD_SIZE]
#define constant SAVE_SALT_OFFSET = [SAVE_TOKEN1_OFFSET] + [WORD_SIZE]
#define constant SAVE_OWNER_PACKED_OFFSET = [SAVE_SALT_OFFSET] + [PACKED_ADDRESS_OFFSET]
#define constant SAVE_AMOUNT0_OFFSET = [SAVE_SALT_OFFSET] + [WORD_SIZE]
#define constant SAVE_AMOUNT1_OFFSET = [SAVE_AMOUNT0_OFFSET] + [WORD_SIZE]
#define constant SAVE_ARGS_SIZE = [SAVE_AMOUNT1_OFFSET] + [WORD_SIZE] - [SAVE_SELECTOR_OFFSET_PACKED]

/* IFlashAccountant#withdraw() */
#define constant WITHDRAW_SELECTOR_OFFSET = 0x
#define constant WITHDRAW_SELECTOR_OFFSET_PACKED = [WITHDRAW_SELECTOR_OFFSET] + [WORD_SIZE] - [SELECTOR_SIZE]
#define constant WITHDRAW_ARGS_OFFSET = [WITHDRAW_SELECTOR_OFFSET] + [WORD_SIZE]
#define constant WITHDRAW_TOKEN_OFFSET = [WITHDRAW_ARGS_OFFSET] - [PACKED_ADDRESS_OFFSET]
#define constant WITHDRAW_RECIPIENT_OFFSET = [WITHDRAW_TOKEN_OFFSET] + [ADDRESS_SIZE]
#define constant WITHDRAW_RECIPIENT_OFFSET_PACKED = [WITHDRAW_ARGS_OFFSET] + [ADDRESS_SIZE]
#define constant WITHDRAW_AMOUNT_OFFSET = [WITHDRAW_RECIPIENT_OFFSET] + [HALFWORD_SIZE]
#define constant WITHDRAW_ARGS_SIZE = [WITHDRAW_AMOUNT_OFFSET] + [WORD_SIZE] - [WITHDRAW_SELECTOR_OFFSET_PACKED]

// IFlashAccountant#startPayments() and // IFlashAccountant#completePayments() input offsets
#define constant START_COMPLETE_PAYMENTS_SELECTOR_OFFSET = 0x
#define constant START_COMPLETE_PAYMENTS_SELECTOR_OFFSET_PACKED = [START_COMPLETE_PAYMENTS_SELECTOR_OFFSET] + [WORD_SIZE] - [SELECTOR_SIZE]
#define constant START_COMPLETE_PAYMENTS_TOKEN_OFFSET = [START_COMPLETE_PAYMENTS_SELECTOR_OFFSET] + [WORD_SIZE]
#define constant START_COMPLETE_PAYMENTS_ARGS_SIZE = [START_COMPLETE_PAYMENTS_TOKEN_OFFSET] + [WORD_SIZE] - [START_COMPLETE_PAYMENTS_SELECTOR_OFFSET_PACKED]

// IERC20#transferFrom(address from, address to, uint256 amount)
#define constant TRANSFER_FROM_SELECTOR = __FUNC_SIG("transferFrom(address,address,uint256)")
#define constant TRANSFER_FROM_SELECTOR_OFFSET = [START_COMPLETE_PAYMENTS_TOKEN_OFFSET] + [WORD_SIZE]
#define constant TRANSFER_FROM_SELECTOR_OFFSET_PACKED = [TRANSFER_FROM_SELECTOR_OFFSET] + [PACKED_SELECTOR_OFFSET]
#define constant TRANSFER_FROM_FROM_OFFSET = [TRANSFER_FROM_SELECTOR_OFFSET] + [WORD_SIZE]
#define constant TRANSFER_FROM_TO_OFFSET = [TRANSFER_FROM_FROM_OFFSET] + [WORD_SIZE]
#define constant TRANSFER_FROM_ARGS_SIZE = [TRANSFER_TRANSFER_FROM_AMOUNT_OFFSET] + [WORD_SIZE] - [TRANSFER_FROM_SELECTOR_OFFSET_PACKED]

// IERC20#transfer(address to, uint256 amount)
#define constant TRANSFER_SELECTOR = __FUNC_SIG("transfer(address,uint256)")
#define constant TRANSFER_SELECTOR_OFFSET = [TRANSFER_FROM_SELECTOR_OFFSET] + [WORD_SIZE]
#define constant TRANSFER_SELECTOR_OFFSET_PACKED = [TRANSFER_SELECTOR_OFFSET] + [PACKED_SELECTOR_OFFSET]
#define constant TRANSFER_TO_OFFSET = [TRANSFER_SELECTOR_OFFSET] + [WORD_SIZE]
#define constant TRANSFER_ARGS_SIZE = [TRANSFER_TRANSFER_FROM_AMOUNT_OFFSET] + [WORD_SIZE] - [TRANSFER_SELECTOR_OFFSET_PACKED]

#define constant TRANSFER_TRANSFER_FROM_AMOUNT_OFFSET = [TRANSFER_FROM_TO_OFFSET] + [WORD_SIZE]

/* Output offsets */
// TODO Arithmetic
#define constant RETURN_DATA_CALCULATED_AMOUNT_OFFSET = 0xc4
#define constant RETURN_DATA_INTEGRATION_FEE_OFFSET = 0xe4

#define constant SLIPPAGE_CHECK_FAILED_SELECTOR_OFFSET = 0x
#define constant SLIPPAGE_CHECK_FAILED_CALCULATED_AMOUNT_OFFSET = [SLIPPAGE_CHECK_FAILED_SELECTOR_OFFSET] + [SELECTOR_SIZE]
#define constant SLIPPAGE_CHECK_FAILED_ARGS_SIZE = [SLIPPAGE_CHECK_FAILED_CALCULATED_AMOUNT_OFFSET] + [WORD_SIZE] - [SLIPPAGE_CHECK_FAILED_SELECTOR_OFFSET]

/// @notice Ekubo Core callback, executing a multiMultiHopSwap.
///
/// In addition to the calldata described in lock/swap.huff:
///
/// `transferFrom` (32 bytes ABI-encoded `address`, optional as determined in LOCK_SWAP(), non-zero)
/// If this is called via a `delegatecall` (checked via `routerAddress != address(this)`), the
/// swap inputs are transferred from the delegating contract and this value does not exist.
/// Otherwise, approvals to this contract from the caller are consumed to settle the debt.
#define macro LOCKED_SWAP() = takes(0) returns(0) {
    [LOCKED_SWAP_FIRST_WORD_OFFSET] calldataload                            // [firstWord]

    // Parse `specifiedAmountBytes`
    dup1 0x byte                                                            // [specifiedAmountBytes, firstWord]

    // Parse `calculatedAmountThresholdBytes` and compute `calculatedAmountThreshold`
    [LOCKED_SWAP_CALCULATED_AMOUNT_THRESHOLD_OFFSET]                        // [offset, specifiedAmountBytes, firstWord]
    dup3 0x1 byte                                                           // [calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    dup2 calldataload dup2                                                  // [calculatedAmountThresholdBytes, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    [BITS_PER_BYTE] mul                                                     // [calculatedAmountThresholdBits, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    [BITS_PER_WORD] sub shr                                                 // [calculatedAmountThreshold, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    swap2                                                                   // [offset, calculatedAmountThresholdBytes, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    add                                                                     // [offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]

    // Parse `specifiedTokenInfo` and recover `specifiedToken`
    0x                                                                      // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup5 0x2 byte                                                           // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup1 0xff gt specifiedKnownLbl jumpi                                    // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        pop                                                                 // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [ADDRESS_SIZE]                                                      // [addressLength, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        dup3 calldataload 0x60 shr                                          // [specifiedToken, addressLength, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap3                                                               // [offset, addressLength, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        add                                                                 // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        specifiedJoinLbl jump
    specifiedKnownLbl:                                                      // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        STORE_KNOWN_TOKEN(SWAP_FORWARD_TOKEN0_OFFSET_PACKED)                        // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [SWAP_FORWARD_TOKEN0_OFFSET] mload                                          // [specifiedToken, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap2                                                               // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    specifiedJoinLbl:                                                       // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]

    // Parse `calculatedTokenInfo` and recover `calculatedToken`
    0x                                                                      // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup7 0x3 byte                                                           // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup1 0xff gt calculatedKnownLbl jumpi                                   // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        pop                                                                 // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [ADDRESS_SIZE]                                                    // [addressLength, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        dup3 calldataload 0x60 shr                                          // [calculatedToken, addressLength, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap3                                                               // [offset, addressLength, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        add                                                                 // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        calculatedJoinLbl jump
    calculatedKnownLbl:                                                     // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        STORE_KNOWN_TOKEN(SWAP_FORWARD_TOKEN0_OFFSET_PACKED)                        // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [SWAP_FORWARD_TOKEN0_OFFSET] mload                                          // [calculatedToken, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap2                                                               // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    calculatedJoinLbl:                                                      // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    swap7                                                                   // [firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `additionalMultiHops`
    dup1 0x4 byte                                                           // [additionalMultiHops, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x1 add                                                                 // [remainingMultiHopSwaps, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `withIntegrationFee`
    dup2 0x5 byte                                                           // [withIntegrationFee, remainingMultiHopSwaps, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    swap2                                                                   // [firstWord, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `withSqrtRatioLimit | isExactOut`
    0x6 byte                                                                // [withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Load jumptable into memory & take jump
    __tablesize(CONFIG_TABLE) __tablestart(CONFIG_TABLE)                    // [tableStart, tableSize, withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x codecopy                                                             // [withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x20 mul mload jump                                                     // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    noSqrtRatioExactInLbl:                                                  // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
        NO_SQRT_RATIO_EXACT_IN()
    noSqrtRatioExactOutLbl:                                                 // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
        NO_SQRT_RATIO_EXACT_OUT()
    withSqrtRatioExactInLbl:                                                // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
        WITH_SQRT_RATIO_EXACT_IN()
    withSqrtRatioExactOutLbl:                                               // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
        WITH_SQRT_RATIO_EXACT_OUT()

    exactInWithoutIntegrationFeePayErc20:                                   // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        PAY_ERC20_EXACT_IN(ADDRESS_SIZE)

    exactInWithIntegrationFeeLbl:                                           // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup5                                                                // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        SAVE_INTEGRATION_FEE()                                              // [remainingCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup1 STORE_CALCULATED_AMOUNT()                                      // [remainingCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        WITHDRAW_EXACT_IN(
            ADD(INTEGRATION_FEE_SIZE),
            exactInWithIntegrationFeePayErc20,
        )

    exactInWithIntegrationFeePayErc20:                                      // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        PAY_ERC20_EXACT_IN(ADDRESS_PLUS_INTEGRATION_FEE_SIZE)

    exactOutWithoutIntegrationFeePayErc20Lbl:                               // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        PAY_ERC20_EXACT_OUT(ADDRESS_SIZE)                                 // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithoutIntegrationFeeNoRefundLbl:                               // [transferFrom, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        pop                                                                 // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithoutIntegrationFeeRefundSuccessLbl:                          // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        WITHDRAW_EXACT_OUT(__NOOP)

    exactOutWithIntegrationFeeLbl:                                          // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup1 STORE_CALCULATED_AMOUNT()                                      // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        PAY_EXACT_OUT(
            exactOutWithIntegrationFeePayErc20Lbl,
            ADDRESS_PLUS_INTEGRATION_FEE_SIZE,
            exactOutWithIntegrationFeeNoRefundLbl,
            exactOutWithIntegrationFeeRefundSuccessLbl,
        )

    exactOutWithIntegrationFeePayErc20Lbl:                                  // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        PAY_ERC20_EXACT_OUT(ADDRESS_PLUS_INTEGRATION_FEE_SIZE)            // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithIntegrationFeeNoRefundLbl:                                  // [transferFrom, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        pop                                                                 // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithIntegrationFeeRefundSuccessLbl:                             // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup3                                                                // [offset, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        SAVE_INTEGRATION_FEE()                                              // [remainingSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        WITHDRAW_EXACT_OUT(ADD(INTEGRATION_FEE_SIZE))

    slippageCheckFailedLbl:                                                 // [specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        __ERROR(SlippageCheckFailed) [SLIPPAGE_CHECK_FAILED_SELECTOR_OFFSET] mstore                              // [specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        swap3 [SLIPPAGE_CHECK_FAILED_CALCULATED_AMOUNT_OFFSET] mstore                                        // [remainingMultiHopSwaps, withIntegrationFee, specifiedToken, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        [SLIPPAGE_CHECK_FAILED_ARGS_SIZE] [SLIPPAGE_CHECK_FAILED_SELECTOR_OFFSET] revert
}

#define macro NO_SQRT_RATIO_EXACT_IN() = takes(9) returns(0) {
    // takes: [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    __tablesize(HOP_TYPE0_TABLE) __tablestart(HOP_TYPE0_TABLE)              // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    START_EXECUTION(__NOOP)

    baseExtension0Lbl:                                                      // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        BASE_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_IN(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_IN(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    oracleExtension0Lbl:                                                    // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        ORACLE_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_IN(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_IN(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    twammExtension0Lbl:                                                     // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        TWAMM_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_IN(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_IN(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    mevCaptureExtension0Lbl:                                                 // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        MEV_CAPTURE_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_IN(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_IN(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    unknownExtension0Lbl:                                                   // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        UNKNOWN_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_IN(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_IN(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    wrappedToken0Lbl:                                                       // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        WRAPPED_TOKEN_EXACT_IN()
}
#define macro NO_SQRT_RATIO_EXACT_OUT() = takes(9) returns(0)  {
    // takes: [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    __tablesize(HOP_TYPE1_TABLE) __tablestart(HOP_TYPE1_TABLE)              // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    START_EXECUTION(NEG())

    baseExtension1Lbl:                                                      // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        BASE_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_OUT(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_OUT(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    oracleExtension1Lbl:                                                    // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        ORACLE_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_OUT(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_OUT(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    twammExtension1Lbl:                                                     // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        TWAMM_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_OUT(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_OUT(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    mevCaptureExtension1Lbl:                                                 // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        MEV_CAPTURE_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_OUT(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_OUT(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    unknownExtension1Lbl:                                                   // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        UNKNOWN_EXTENSION(
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN0_EXACT_OUT(),
            WITHOUT_SQRT_RATIO_LIMIT_IS_TOKEN1_EXACT_OUT(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    wrappedToken1Lbl:                                                       // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        WRAPPED_TOKEN_EXACT_OUT()
}
#define macro WITH_SQRT_RATIO_EXACT_IN() = takes(9) returns(0) {
    // takes: [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    __tablesize(HOP_TYPE2_TABLE) __tablestart(HOP_TYPE2_TABLE)              // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    START_EXECUTION(__NOOP)

    baseExtension2Lbl:                                                      // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
