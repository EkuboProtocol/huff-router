/// @notice Ekubo Core callback, executing a multiMultiHopSwap.
///
/// In addition to the calldata described in LOCK():
///
/// `transferFrom` (32 bytes ABI-encoded `address`, optional as determined in LOCK(), non-zero)
/// If this is called via a `delegatecall` (checked via `routerAddress != address(this)`), the
/// swap inputs are transferred from the delegating contract and this value does not exist.
/// Otherwise, approvals to this contract from the caller are consumed to settle the debt.
#define macro LOCKED() = takes(0) returns(0) {
    CORE_CHECK()                                                            // []

    [LOCKED_FIRST_WORD_OFFSET] calldataload                                 // [firstWord]

    // Parse `specifiedAmountBytes`
    dup1 0x byte                                                            // [specifiedAmountBytes, firstWord]

    // Parse `calculatedAmountThresholdBytes` and compute `calculatedAmountThreshold`
    [LOCKED_CALCULATED_AMOUNT_THRESHOLD_OFFSET]                             // [offset, specifiedAmountBytes, firstWord]
    dup3 0x1 byte                                                           // [calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    dup2 calldataload dup2                                                  // [calculatedAmountThresholdBytes, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    [BITS_PER_BYTE] mul                                                     // [calculatedAmountThresholdBits, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    [BITS_PER_WORD] sub shr                                                 // [calculatedAmountThreshold, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    swap2                                                                   // [offset, calculatedAmountThresholdBytes, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    add                                                                     // [offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]

    // Parse `specifiedTokenInfo` and recover `specifiedToken`
    0x                                                                      // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup5 0x2 byte                                                           // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup1 0xff gt specifiedKnownLbl jumpi                                    // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        pop                                                                 // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [ADDRESS_LENGTH]                                                    // [addressLength, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        dup3 calldataload 0x60 shr                                          // [specifiedToken, addressLength, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap3                                                               // [offset, addressLength, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        add                                                                 // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        specifiedJoinLbl jump
    specifiedKnownLbl:                                                      // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        STORE_KNOWN_TOKEN(SWAP_TOKEN0_OFFSET_PACKED)                        // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [SWAP_TOKEN0_OFFSET] mload                                          // [specifiedToken, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap2                                                               // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    specifiedJoinLbl:                                                       // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]

    // Parse `calculatedTokenInfo` and recover `calculatedToken`
    0x                                                                      // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup7 0x3 byte                                                           // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup1 0xff gt calculatedKnownLbl jumpi                                   // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        pop                                                                 // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [ADDRESS_LENGTH]                                                    // [addressLength, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        dup3 calldataload 0x60 shr                                          // [calculatedToken, addressLength, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap3                                                               // [offset, addressLength, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        add                                                                 // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        calculatedJoinLbl jump
    calculatedKnownLbl:                                                     // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        STORE_KNOWN_TOKEN(SWAP_TOKEN0_OFFSET_PACKED)                        // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [SWAP_TOKEN0_OFFSET] mload                                          // [calculatedToken, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap2                                                               // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    calculatedJoinLbl:                                                      // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    swap7                                                                   // [firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `additionalMultiHops`
    dup1 0x4 byte 0x1 add                                                   // [remainingMultiHopSwaps, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `withIntegrationFee`
    dup2 0x5 byte                                                           // [withIntegrationFee, remainingMultiHopSwaps, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    swap2                                                                   // [firstWord, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `withSqrtRatioLimit | isExactOut`
    0x6 byte                                                                // [withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Load jumptable into memory & take jump
    __tablesize(CONFIG_TABLE) __tablestart(CONFIG_TABLE)                    // [tableStart, tableSize, withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x codecopy                                                             // [withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x20 mul mload jump                                                     // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    noSqrtRatioExactInLbl:                                                  // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
        NO_SQRT_RATIO_EXACT_IN()
    noSqrtRatioExactOutLbl:
        NO_SQRT_RATIO_EXACT_OUT()
    withSqrtRatioExactInLbl:
        WITH_SQRT_RATIO_EXACT_IN()
    withSqrtRatioExactOutLbl:
        WITH_SQRT_RATIO_EXACT_OUT()

    exactInWithoutIntegrationFeePayErc20:                                   // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        PAY_ERC20_EXACT_IN(ADDRESS_LENGTH)

    exactInWithIntegrationFeeLbl:                                           // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup5                                                                // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        SAVE_INTEGRATION_FEE()                                              // [remainingCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup1 STORE_CALCULATED_AMOUNT()                                      // [remainingCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        WITHDRAW_EXACT_IN(
            ADD(INTEGRATION_FEE_LENGTH),
            exactInWithIntegrationFeePayErc20,
        )

    exactInWithIntegrationFeePayErc20:                                      // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        PAY_ERC20_EXACT_IN(ADDRESS_PLUS_INTEGRATION_FEE_LENGTH)

    exactOutWithoutIntegrationFeePayErc20Lbl:                               // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        PAY_ERC20_EXACT_OUT(ADDRESS_LENGTH)                                 // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithoutIntegrationFeeNoRefundLbl:                               // [transferFrom, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        pop                                                                 // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithoutIntegrationFeeRefundSuccessLbl:                          // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        WITHDRAW_EXACT_OUT(NO_OP())

    exactOutWithIntegrationFeeLbl:                                          // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup1 STORE_CALCULATED_AMOUNT()                                      // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        TRANSFER_IF_NATIVE_EXACT_OUT(
            exactOutWithIntegrationFeePayErc20Lbl,
            ADDRESS_PLUS_INTEGRATION_FEE_LENGTH,
            exactOutWithIntegrationFeeNoRefundLbl,
            exactOutWithIntegrationFeeRefundSuccessLbl,
        )

    exactOutWithIntegrationFeePayErc20Lbl:                                  // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        PAY_ERC20_EXACT_OUT(ADDRESS_PLUS_INTEGRATION_FEE_LENGTH)            // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithIntegrationFeeNoRefundLbl:                                  // [transferFrom, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        pop                                                                 // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithIntegrationFeeRefundSuccessLbl:                             // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup3                                                                // [offset, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        SAVE_INTEGRATION_FEE()                                              // [remainingSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        WITHDRAW_EXACT_OUT(ADD(INTEGRATION_FEE_LENGTH))

    slippageCheckFailedLbl:                                                 // [specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        __ERROR(SlippageCheckFailed) 0x mstore                              // [specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        swap3 0x4 mstore                                                    // [remainingMultiHopSwaps, withIntegrationFee, specifiedToken, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        0x24 0x revert
}

#define macro NO_SQRT_RATIO_EXACT_IN() = {
    __tablesize(HOP_TYPE0_TABLE) __tablestart(HOP_TYPE0_TABLE)              // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    EXECUTE_PRELUDE(NO_OP())

    baseExtension0Lbl:                                                      // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        BASE_EXTENSION(
            STORE_MIN_SQRT_RATIO(),
            STORE_MAX_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    oracleExtension0Lbl:                                                    // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        ORACLE_EXTENSION(
            STORE_MIN_SQRT_RATIO(),
            STORE_MAX_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    twammExtension0Lbl:                                                     // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        TWAMM_EXTENSION(
            STORE_MIN_SQRT_RATIO(),
            STORE_MAX_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    mevResistExtension0Lbl:                                                 // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        MEV_RESIST_EXTENSION(
            STORE_MIN_SQRT_RATIO(),
            STORE_MAX_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    unknownExtension0Lbl:                                                   // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        UNKNOWN_EXTENSION(
            STORE_MIN_SQRT_RATIO(),
            STORE_MAX_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    wrappedToken0Lbl:                                                       // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        WRAPPED_TOKEN_EXACT_IN()
}

#define macro NO_SQRT_RATIO_EXACT_OUT() = {
    __tablesize(HOP_TYPE1_TABLE) __tablestart(HOP_TYPE1_TABLE)              // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    EXECUTE_PRELUDE(NEG())

    baseExtension1Lbl:                                                      // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        BASE_EXTENSION(
            STORE_MAX_SQRT_RATIO(),
            STORE_MIN_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    oracleExtension1Lbl:                                                    // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        ORACLE_EXTENSION(
            STORE_MAX_SQRT_RATIO(),
            STORE_MIN_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    twammExtension1Lbl:                                                     // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        TWAMM_EXTENSION(
            STORE_MAX_SQRT_RATIO(),
            STORE_MIN_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    mevResistExtension1Lbl:                                                 // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        MEV_RESIST_EXTENSION(
            STORE_MAX_SQRT_RATIO(),
            STORE_MIN_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    unknownExtension1Lbl:                                                   // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        UNKNOWN_EXTENSION(
            STORE_MAX_SQRT_RATIO(),
            STORE_MIN_SQRT_RATIO(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    wrappedToken1Lbl:                                                       // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        WRAPPED_TOKEN_EXACT_OUT()
}

#define macro WITH_SQRT_RATIO_EXACT_IN() = {
    __tablesize(HOP_TYPE2_TABLE) __tablestart(HOP_TYPE2_TABLE)              // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    EXECUTE_PRELUDE(NO_OP())

    baseExtension2Lbl:                                                      // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        BASE_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    oracleExtension2Lbl:                                                    // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        ORACLE_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    twammExtension2Lbl:                                                     // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        TWAMM_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    mevResistExtension2Lbl:                                                 // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        MEV_RESIST_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    unknownExtension2Lbl:                                                   // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        UNKNOWN_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
        )
    wrappedToken2Lbl:                                                       // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        WRAPPED_TOKEN_EXACT_IN()
}

#define macro WITH_SQRT_RATIO_EXACT_OUT() = {
    __tablesize(HOP_TYPE3_TABLE) __tablestart(HOP_TYPE3_TABLE)              // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    EXECUTE_PRELUDE(NEG())

    baseExtension3Lbl:                                                      // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        BASE_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    oracleExtension3Lbl:                                                    // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        ORACLE_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    twammExtension3Lbl:                                                     // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        TWAMM_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    mevResistExtension3Lbl:                                                 // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        MEV_RESIST_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    unknownExtension3Lbl:                                                   // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        UNKNOWN_EXTENSION(
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
            SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
        )
    wrappedToken3Lbl:                                                       // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        WRAPPED_TOKEN_EXACT_OUT()
}

#define macro STORE_KNOWN_TOKEN(offset) = takes(1) returns(0) {
    // takes: [tokenId]
    [ADDRESS_LENGTH] mul                                                    // [tokenOffset]
    [ADDRESS_LENGTH] swap1                                                  // [tokenOffset, addressLength]
    __tablestart(TOKENS) add                                                // [tokenLocation, addressLength]

    <offset> codecopy                                                       // []
}

#define macro NO_OP() = takes(0) returns(0) {}

#define macro NEG() = takes(1) returns(1) {
    // takes: [number]
    0x sub                                                                  // [negated]
}

#define macro EXECUTE_PRELUDE(specifiedSign) = takes(11) returns(0) {
    // takes: [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Copy the packed jump table to a destination that we know we won't override.
    [MAX_ARGS_OFFSET] codecopy                                              // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    dup6                                                                    // [nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    dup9 [BITS_PER_BYTE] mul                                                // [specifiedAmountBits, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    swap10                                                                  // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    multiHopLbl:                                                            // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        // Read and store `specifiedAmount` and add to `totalSpecified`
        dup1 calldataload                                                   // [specifiedAmountWord, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup12 [BITS_PER_WORD] sub shr                                       // [specifiedAmountUnsigned, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup1 <specifiedSign>                                                // [nextSpecifiedAmount, specifiedAmountUnsigned, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        swap8                                                               // [totalSpecified, specifiedAmountUnsigned, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        add                                                                 // [totalSpecified, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        swap1                                                               // [offset, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup11 add                                                           // [offset, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        // Read `additionalHops`
        dup1 calldataload 0x byte                                           // [additionalHops, offset, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        swap1                                                               // [offset, additionalHops, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x1 add                                                             // [offset, additionalHops, totalSpecified, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        swap2                                                               // [totalSpecified, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, nextSpecifiedAmount, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        swap8                                                               // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        singleHopLbl:                                                       // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            dup3 calldataload                                               // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            dup1 0x byte                                                    // [hopType, hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            // Lookup in packed jump table
            0x2 mul [MAX_ARGS_OFFSET] add                                   // [jumpPackedOffset, hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            mload 0xf0 shr                                                  // [jumpOffset, hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            jump
}

#define macro BASE_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, settleBalances) = takes(14) returns(0) {
    // takes: [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup1 0x10 shl 0xa0 shr [SWAP_CONFIG_OFFSET] mstore                      // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_SWAP_SELECTOR()                                                   // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    STORE_SKIP_AHEAD()                                                      // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [SWAP_AMOUNT_OFFSET] mstore                                             // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    EXECUTE_SWAP_CHECK_LAST(
        BASE_EXTENSION_CALLDATA_LENGTH,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
        <settleBalances>,
        multiHopLbl,
    )
}

#define macro ORACLE_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, settleBalances) = takes(14) returns(0) {
    // takes: [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    pop                                                                     // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [SWAP_AMOUNT_OFFSET] mstore                                             // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    // Fee and tick spacing are zero
    __RIGHTPAD([ORACLE]) [SWAP_CONFIG_OFFSET] mstore                        // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_SWAP_SELECTOR()                                                   // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    EXECUTE_SWAP_CHECK_LAST(
        ORACLE_EXTENSION_CALLDATA_LENGTH,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
        <settleBalances>,
        multiHopLbl,
    )
}

#define macro TWAMM_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, settleBalances) = takes(14) returns(0) {
    // takes: [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    0x98 shr 0xffffffffffffffff00000000 and                                 // [shiftedFee, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    __RIGHTPAD([TWAMM]) or [SWAP_CONFIG_OFFSET] mstore                      // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [SWAP_AMOUNT_OFFSET] mstore                                             // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_SWAP_SELECTOR()                                                   // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    EXECUTE_SWAP_CHECK_LAST(
        TWAMM_EXTENSION_CALLDATA_LENGTH,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
        <settleBalances>,
        multiHopLbl,
    )
}

#define macro MEV_RESIST_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, settleBalances) = takes(14) returns(0) {
    // takes: [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup1 0x10 shl 0xa0 shr                                                  // [configWithoutExtension, hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    __RIGHTPAD([MEV_RESIST]) or                                             // [config, hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [SWAP_CONFIG_OFFSET] mstore                                             // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_FORWARD_SELECTOR()                                                // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [MEV_RESIST] [FORWARD_TO_OFFSET] mstore                                 // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    STORE_SKIP_AHEAD()                                                      // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [SWAP_AMOUNT_OFFSET] mstore                                             // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    EXECUTE_SWAP_CHECK_LAST(
        MEV_RESIST_EXTENSION_CALLDATA_LENGTH,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_FORWARD_CALL_OFFSET_AND_LENGTH(),
        <settleBalances>,
        multiHopLbl,
    )
}

#define macro UNKNOWN_EXTENSION(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, settleBalances) = takes(14) returns(0) {
    // takes: [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    0x20 dup5 0x2 add [SWAP_CONFIG_OFFSET] calldatacopy                     // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_SWAP_SELECTOR()                                                   // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    STORE_SKIP_AHEAD()                                                      // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [SWAP_AMOUNT_OFFSET] mstore                                             // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    EXECUTE_SWAP_CHECK_LAST(
        UNKNOWN_EXTENSION_CALLDATA_LENGTH,
        <sqrtRatioLimitIsToken0>,
        <sqrtRatioLimitIsToken1>,
        PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
        <settleBalances>,
        multiHopLbl,
    )
}

#define macro WRAPPED_TOKEN_EXACT_IN() = takes(14) returns(0) {
    // takes: [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    WRAPPED_TOKEN(
        NO_OP(),
        NEG(),

        EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_CALCULATED(dup6),
        EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_CALCULATED(dup3),
        EXECUTE_WRAPPED_TOKEN_NOT_LAST_WRAPPER_ALREADY_STORED(),

        EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_SPECIFIED(),
        EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_SPECIFIED(),
        EXECUTE_WRAPPED_TOKEN_NOT_LAST_WRAPPER_NOT_STORED(EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_SPECIFIED()),

        SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN,
    )
}

#define macro WRAPPED_TOKEN_EXACT_OUT() = takes(14) returns(0) {
    // takes: [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    WRAPPED_TOKEN(
        NEG(),
        NO_OP(),

        EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_SPECIFIED(),
        EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_SPECIFIED(),
        EXECUTE_WRAPPED_TOKEN_NOT_LAST_WRAPPER_NOT_STORED(EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_SPECIFIED()),

        EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_CALCULATED(dup6),
        EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_CALCULATED(dup3),
        EXECUTE_WRAPPED_TOKEN_NOT_LAST_WRAPPER_ALREADY_STORED(),

        SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT,
    )
}

#define macro WRAPPED_TOKEN(
    nextSpecifiedAmountOp,
    hopCalculatedAmountOp,

    wrapLastReplaceWithWrapper,
    wrapNotLastUnknownTokenReplaceWithWrapper,
    wrapNotLastKnownTokenStoreTo,

    unwrapLastReplaceWithWrapper,
    unwrapNotLastUnknownTokenReplaceWithWrapper,
    unwrapNotLastKnownTokenStoreTo,

    settleBalancesIfLastMultiHop,
) = takes(14) returns(0) {
    // takes: [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    STORE_FORWARD_SELECTOR()                                                // [hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    0x1 byte dup1                                                           // [callType, callType, hopWord, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [WRAPPED_TOKEN_CALL_TYPE_OFFSET] mstore                                 // [callType, nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    unwrapLbl jumpi                                                         // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <nextSpecifiedAmountOp> [WRAPPED_TOKEN_AMOUNT_OFFSET] mstore        // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        EXECUTE_CHECK_LAST(
            WRAPPED_TOKEN_CALLDATA_LENGTH,
            EXECUTE_WRAPPED_TOKEN_LAST(
                <wrapLastReplaceWithWrapper>,
                <hopCalculatedAmountOp>,
            ),
            EXECUTE_WRAPPED_TOKEN_NOT_LAST(
                EXECUTE_WRAPPED_TOKEN_NOT_LAST_WRAPPER_NOT_STORED(
                    <wrapNotLastUnknownTokenReplaceWithWrapper>,
                ),
                <nextSpecifiedAmountOp>,
            ),
            FORWARD_TO_OFFSET_PACKED,
            FORWARD_TO_OFFSET,
            EXECUTE_WRAPPED_TOKEN_NOT_LAST(
                <wrapNotLastKnownTokenStoreTo>,
                <nextSpecifiedAmountOp>,
            ),
            <settleBalancesIfLastMultiHop>,
            multiHopLbl,
        )
    unwrapLbl:                                                              // [nextSpecifiedAmount, additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <nextSpecifiedAmountOp> [WRAPPED_TOKEN_AMOUNT_OFFSET] mstore        // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        EXECUTE_CHECK_LAST(
            WRAPPED_TOKEN_CALLDATA_LENGTH,
            EXECUTE_WRAPPED_TOKEN_LAST(
                <unwrapLastReplaceWithWrapper>,
                <hopCalculatedAmountOp>,
            ),
            EXECUTE_WRAPPED_TOKEN_NOT_LAST(
                EXECUTE_WRAPPED_TOKEN_NOT_LAST_WRAPPER_NOT_STORED(
                    <unwrapNotLastUnknownTokenReplaceWithWrapper>,
                ),
                <nextSpecifiedAmountOp>,
            ),
            FORWARD_TO_OFFSET_PACKED,
            FORWARD_TO_OFFSET,
            EXECUTE_WRAPPED_TOKEN_NOT_LAST(
                <unwrapNotLastKnownTokenStoreTo>,
                <nextSpecifiedAmountOp>,
            ),
            <settleBalancesIfLastMultiHop>,
            multiHopLbl,
        )
}

#define macro EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_SPECIFIED() = {}
#define macro EXECUTE_WRAPPED_TOKEN_WRAPPER_IS_CALCULATED(dup) = {
    pop <dup>
}

#define macro EXECUTE_WRAPPED_TOKEN_LAST(replaceWithWrapper, amountOp) = {
    // takes: [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup8 swap2                                                              // [nextSpecifiedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    <replaceWithWrapper>                                                    // [wrapper, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [FORWARD_TO_OFFSET] mstore                                              // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    CALL_TOKEN_WRAPPER()                                                    // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    swap4                                                                   // [totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    [WRAPPED_TOKEN_AMOUNT_OFFSET] mload                                     // [hopCalculatedUnsigned, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    <amountOp>                                                              // [hopCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
}

#define macro EXECUTE_WRAPPED_TOKEN_NOT_LAST_WRAPPER_ALREADY_STORED() = {
    // takes: [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    pop                                                                     // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
}

#define macro EXECUTE_WRAPPED_TOKEN_NOT_LAST_WRAPPER_NOT_STORED(replaceWithWrapper) = {
    // takes: [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    <replaceWithWrapper>                                                    // [wrapper, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    [FORWARD_TO_OFFSET] mstore                                              // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
}

#define macro EXECUTE_WRAPPED_TOKEN_NOT_LAST(storeTo, amountOp) = {
    // takes: [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    <storeTo>

    swap1                                                                   // [additionalHops, offset, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    CALL_TOKEN_WRAPPER()                                                    // [additionalHops, offset, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    [WRAPPED_TOKEN_AMOUNT_OFFSET] mload                                     // [nextSpecifiedAmountUnsigned, additionalHops, offset, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    <amountOp>                                                              // [nextSpecifiedAmount, additionalHops, offset, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    singleHopLbl jump
}

#define macro CALL_TOKEN_WRAPPER() = {
    0x 0x [WRAPPED_TOKEN_ARGS_SIZE] 0x 0x [CORE] gas call
    pop
}

#define macro EXECUTE_SWAP_LAST() = takes(12) returns(12) {
    // takes: [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    dup6                                                                // [nextCalculatedToken, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup9                                                                // [specifiedToken, nextCalculatedToken, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    swap3                                                               // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    dup1 dup3                                                           // [nextCalculatedToken, nextSpecifiedToken, nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    lt isToken1LastLbl jumpi                                            // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN0_OFFSET] mstore                                     // [nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN1_OFFSET] mstore                                     // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <sqrtRatioLimitIsToken0>                                        // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x [SWAP_IS_TOKEN1_OFFSET] mstore                               // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        CALL_SWAP(<callArgs>)                                           // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        swap4 [SWAP_DELTA1_OFFSET] mload                                // [hopCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        isToken1LastJoinLbl jump
    isToken1LastLbl:                                                    // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN1_OFFSET] mstore                                     // [nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN0_OFFSET] mstore                                     // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <sqrtRatioLimitIsToken1>                                        // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x1 [SWAP_IS_TOKEN1_OFFSET] mstore                              // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        CALL_SWAP(<callArgs>)                                           // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        swap4 [SWAP_DELTA0_OFFSET] mload                                // [hopCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    isToken1LastJoinLbl:                                                // [hopCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
}

#define macro EXECUTE_SWAP_NOT_LAST(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, callArgs, storeToken0) = takes(13) returns(0) {
    // takes: [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    dup1 dup5                                                       // [nextCalculatedToken, nextSpecifiedToken, nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    lt notLastSwapUnknownTokenIsToken1Lbl jumpi                     // [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        [SWAP_TOKEN0_OFFSET] mstore                                 // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        dup3 [SWAP_TOKEN1_OFFSET] mstore                            // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <sqrtRatioLimitIsToken0>                                    // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        0x [SWAP_IS_TOKEN1_OFFSET] mstore                           // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        CALL_SWAP(<callArgs>)                                       // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        JUMP_TO_NEXT_HOP(SWAP_DELTA1_OFFSET)
    notLastSwapUnknownTokenIsToken1Lbl:                             // [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        NOT_LAST_SWAP_IS_TOKEN1(
            <storeToken0>,
            <sqrtRatioLimitIsToken1>,
            <callArgs>,
        )
}

#define macro EXECUTE_SWAP_NOT_LAST_KNOWN_TOKEN(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, callArgs) = takes(13) returns(0) {
    // takes: [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    EXECUTE_SWAP_NOT_LAST(<sqrtRatioLimitIsToken0>, <sqrtRatioLimitIsToken1>, <callArgs>, NO_OP())
}

#define macro EXECUTE_SWAP_NOT_LAST_UNKNOWN_TOKEN(sqrtRatioLimitIsToken0, sqrtRatioLimitIsToken1, callArgs) = takes(13) returns(0) {
    // takes: [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    EXECUTE_SWAP_NOT_LAST(<sqrtRatioLimitIsToken0>, <sqrtRatioLimitIsToken1>, <callArgs>, TOKEN0_NOT_IN_MEMORY())
}

#define macro EXECUTE_SWAP_CHECK_LAST(
    hopLength,
    sqrtRatioLimitIsToken0,
    sqrtRatioLimitIsToken1,
    callArgs,
    settleBalancesIfLastMultiHop,
    multiHopLbl,
) = takes(12) returns(0) {
    // takes: [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    EXECUTE_CHECK_LAST(
        <hopLength>,
        EXECUTE_SWAP_LAST(
            <sqrtRatioLimitIsToken0>,
            <sqrtRatioLimitIsToken1>,
            <callArgs>,
        ),
        EXECUTE_SWAP_NOT_LAST_UNKNOWN_TOKEN(
            <sqrtRatioLimitIsToken0>,
            <sqrtRatioLimitIsToken1>,
            <callArgs>,
        ),
        SWAP_TOKEN0_OFFSET_PACKED,
        SWAP_TOKEN0_OFFSET,
        EXECUTE_SWAP_NOT_LAST_KNOWN_TOKEN(
            <sqrtRatioLimitIsToken0>,
            <sqrtRatioLimitIsToken1>,
            <callArgs>,
        ),
        <settleBalancesIfLastMultiHop>,
        <multiHopLbl>,
    )
}

#define macro EXECUTE_CHECK_LAST(
    hopLength,
    executeLast,
    executeNotLastUnknownToken,
    knownTokenOffsetPacked,
    knownTokenOffset,
    executeNotLastKnownToken,
    settleBalancesIfLastMultiHop,
    multiHopLbl,
) = takes(12) returns(0) {
    // takes: [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup1 notLastSwapLbl jumpi                                               // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        pop                                                                 // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <hopLength> add                                                     // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        <executeLast>                                                       // [hopCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <settleBalancesIfLastMultiHop>(<multiHopLbl>)
    notLastSwapLbl:
        [MINUS_ONE] add                                                     // [additionalHops, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        swap1                                                               // [offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        <hopLength> add                                                     // [offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        dup1 calldataload 0x byte                                           // [tokenInfo, offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        dup1 0xff gt notLastSwapKnownTokenLbl jumpi                         // [tokenInfo, offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            pop                                                             // [offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            // Move the offset to after the token address and load the address
            0x15 add                                                        // [offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            [ADDRESS_LENGTH] dup2 sub calldataload 0x60 shr                 // [nextCalculatedToken, offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            // Swap specified and calculated token such that they are in the right place for the next iteration
            swap3                                                           // [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            <executeNotLastUnknownToken>
        notLastSwapKnownTokenLbl:                                           // [tokenInfo, offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            STORE_KNOWN_TOKEN(<knownTokenOffsetPacked>)                     // [offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            0x1 add                                                         // [offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            <knownTokenOffset> mload                                        // [nextCalculatedToken, offset, additionalHops, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            // Swap specified and calculated token such that they are in the right place for the next iteration
            swap3                                                           // [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            <executeNotLastKnownToken>
}

#define macro STORE_MIN_SQRT_RATIO() = takes(0) returns(0) {
    [MIN_SQRT_RATIO] [SWAP_SQRT_RATIO_LIMIT_OFFSET] mstore                  // []
}

#define macro STORE_MAX_SQRT_RATIO() = takes(0) returns(0) {
    [MAX_SQRT_RATIO] [SWAP_SQRT_RATIO_LIMIT_OFFSET] mstore                  // []
}

#define macro STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA() = takes(1) returns(1) {
    // takes: [offset]
    0xc dup2 [SWAP_SQRT_RATIO_LIMIT_OFFSET_PACKED] calldatacopy             // [offset]
    0xc add                                                                 // [offset]
}

#define macro STORE_SWAP_SELECTOR() = takes(0) returns(0) {
    0x 0x4 mstore                                                           // []
}

#define macro STORE_SKIP_AHEAD() = takes(1) returns(0) {
    // takes: [hopWord]
    0x1 byte                                                                // [skipAhead]
    [SWAP_SKIP_AHEAD_OFFSET] mstore                                         // []
}

#define macro STORE_FORWARD_SELECTOR() = takes(0) returns(0) {
    __RIGHTPAD(__FUNC_SIG("forward(address)")) 0x mstore                    // []
}

#define macro PUSH_SWAP_CALL_OFFSET_AND_LENGTH() = takes(0) returns(2) {
    0xe4 0x20                                                               // [argsOffset, argsSize]
}

#define macro PUSH_FORWARD_CALL_OFFSET_AND_LENGTH() = takes(0) returns(2) {
    0x104 0x                                                                // [argsOffset, argsSize]
}

#define macro SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_IN(multiHopLbl) = takes(12) returns(0) {
    // takes: [hopCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    SETTLE_BALANCES_IF_LAST_MULTIHOP(
        ADD_CALCULATED_EXACT_IN(),
        <multiHopLbl>,
        SLIPPAGE_CHECK_EXACT_IN(),
    )                                                                       // [withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactInWithIntegrationFeeLbl jumpi                                      // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup1 STORE_RETURN_DATA_NO_INTEGRATION_FEE()                         // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        WITHDRAW_EXACT_IN(
            NO_OP(),
            exactInWithoutIntegrationFeePayErc20,
        )
}

#define macro SLIPPAGE_CHECK_EXACT_IN() = takes(5) returns(5) {
    // takes: [calculatedAmountThreshold, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated]

    dup5 lt                                                                 // [slippageCheckFailed, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated]
}

#define macro STORE_RETURN_DATA_NO_INTEGRATION_FEE() = takes(1) returns(0) {
    // takes: [totalCalculated]

    STORE_CALCULATED_AMOUNT()                                               // []
    0x [RETURN_DATA_INTEGRATION_FEE_OFFSET] mstore                          // []
}

#define macro STORE_CALCULATED_AMOUNT() = takes(1) returns(0) {
    // takes: [amount]
    [RETURN_DATA_CALCULATED_AMOUNT_OFFSET] mstore                           // []
}

#define macro SETTLE_BALANCES_IF_LAST_MULTIHOP_EXACT_OUT(multiHopLbl) = takes(12) returns(0) {
    // takes: [hopCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    SETTLE_BALANCES_IF_LAST_MULTIHOP(
        ADD_CALCULATED_EXACT_OUT(),
        <multiHopLbl>,
        SLIPPAGE_CHECK_EXACT_OUT(),
    )                                                                       // [withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    exactOutWithIntegrationFeeLbl jumpi                                     // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        dup1 STORE_RETURN_DATA_NO_INTEGRATION_FEE()                         // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        TRANSFER_IF_NATIVE_EXACT_OUT(
            exactOutWithoutIntegrationFeePayErc20Lbl,
            ADDRESS_LENGTH,
            exactOutWithoutIntegrationFeeNoRefundLbl,
            exactOutWithoutIntegrationFeeRefundSuccessLbl,
        )
}

#define macro SLIPPAGE_CHECK_EXACT_OUT() = takes(5) returns(5) {
    // takes: [calculatedAmountThreshold, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated]

    // This allows us to efficiently encode the case of skipping
    // the slippage check with a `calculatedAmountThreshold` of zero bytes
    [MINUS_ONE] add                                                         // [calculatedAmountThreshold, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated]

    dup5 gt                                                                 // [slippageCheckFailed, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated]
}

#define macro SETTLE_BALANCES_IF_LAST_MULTIHOP(addCalculated, multiHopLbl, compOp) = takes(12) returns(8) {
    // takes: [hopCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    <addCalculated>                                                         // [totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    swap4                                                                   // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    // Decrement `remainingMultiHopSwaps`
    swap2 [MINUS_ONE] add swap2                                             // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    dup3 <multiHopLbl> jumpi                                                // [offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    swap8                                                                   // [calculatedAmountThreshold, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    <compOp> slippageCheckFailedLbl jumpi                                   // [specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    pop pop                                                                 // [withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
}

#define macro ADD_CALCULATED_EXACT_IN() = takes(2) returns(1) {
    // takes: [hopCalculated, totalCalculated]
    swap1 sub                                                               // [totalCalculated]
}

#define macro ADD_CALCULATED_EXACT_OUT() = takes(2) returns(1) {
    // takes: [hopCalculated, totalCalculated]
    add                                                                     // [totalCalculated]
}

#define macro SLIPPAGE_CHECK_FAILED() = takes(1) returns(0) {
    // takes: [totalCalculated]

    __ERROR(SlippageCheckFailed) 0x mstore                                  // [totalCalculated]
    0x4 mstore                                                              // []
    0x24 0x revert
}

#define macro SAVE_INTEGRATION_FEE() = takes(3) returns(2) {
    // takes: [calldataOffset, total, token]

    __tablesize(SAVE_DATA) __tablestart(SAVE_DATA) 0x codecopy              // [calldataOffset, total, token]

    [ADDRESS_LENGTH]                                                        // [addressLength, calldataOffset, total, token]
    dup2 0x2 add                                                            // [integratorOffset, addressLength, calldataOffset, total, token]
    [SAVE_OWNER_PACKED_OFFSET] calldatacopy                                 // [calldataOffset, total, token]

    dup3 [SAVE_TOKEN0_OFFSET] mstore                                        // [calldataOffset, total, token]

    calldataload 0xf0 shr                                                   // [feeShare, total, token]
    dup2 mul 0x10 shr                                                       // [integratorShare, total, token]

    dup1 [RETURN_DATA_INTEGRATION_FEE_OFFSET] mstore                        // [integratorShare, total, token]

    dup1 [SAVE_AMOUNT0_OFFSET] mstore                                       // [integratorShare, total, token]
    0x [SAVE_AMOUNT1_OFFSET] mstore                                         // [integratorShare, total, token]
    swap1 sub                                                               // [remaining, token]

    // ICore#save(address owner, address token0, address token1, bytes32 salt, uint128 amount0, uint128 amount1)
    0x 0x [SAVE_ARGS_SIZE] 0x 0x [CORE] gas call                            // [success, remaining, token]
    pop                                                                     // [remaining, token]
}

#define macro TRANSFER_IF_NATIVE_EXACT_OUT(erc20Lbl, transferFromOffset, noRefundLbl, refundSuccessLbl) = takes(7) returns(0) {
    // takes: [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    dup2 <erc20Lbl> jumpi                                                   // [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        // Transfer native token to Core
        0x 0x 0x 0x swap4 [CORE] gas call                                   // [success, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        pop pop                                                             // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        // Refund potential remaining balance to the caller (if not in a `delegatecall`)

        dup3 <transferFromOffset> add calldataload                          // [transferFrom, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        selfbalance                                                         // [selfbalance, transferFrom, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

        iszero dup2 iszero or                                               // [noRefund, transferFrom, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        <noRefundLbl> jumpi                                                 // [transferFrom, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
            // Transfer remaining balance
            0x 0x 0x selfbalance 0x swap5 gas call                          // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

            <refundSuccessLbl> jumpi                                        // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
                __ERROR(ETHTransferFailed) 0x mstore                        // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
                0x4 0x revert
}

#define macro WITHDRAW_EXACT_IN(afterDup, erc20Lbl) = takes(7) returns(0) {
    // takes: [remainingCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    WITHDRAW(PUSH_OFFSET_AND(dup4, <afterDup>))                             // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
    pop                                                                     // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    dup2 <erc20Lbl> jumpi                                                   // [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        // Transfer native token to Core
        0x 0x 0x 0x swap4 [CORE] gas call                                   // [success, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
        LOCKED_RETURN()
}

#define macro LOCKED_RETURN() = takes(0) returns(0) {
    0x40 [RETURN_DATA_CALCULATED_AMOUNT_OFFSET] return
}

#define macro WITHDRAW_EXACT_OUT(afterDup) = takes(5) returns(0) {
    // takes: [amount, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    WITHDRAW(PUSH_OFFSET_AND(swap1, <afterDup>))                            // [success, specifiedAmountBytes, specifiedAmountBits]
    LOCKED_RETURN()
}

#define macro WITHDRAW(pushOffset) = takes(2) returns(1) {
    // takes: [amount, token]

    __RIGHTPAD(__FUNC_SIG("withdraw(address,address,uint128)")) 0x mstore   // [amount, token]
    [WITHDRAW_AMOUNT_OFFSET] mstore                                         // [token]
    [WITHDRAW_TOKEN_OFFSET] mstore                                          // []
    [ADDRESS_LENGTH] <pushOffset> [WITHDRAW_RECIPIENT_OFFSET_PACKED]        // [recipientOffset, offset, addressLength]
    calldatacopy                                                            // []

    // ICore#withdraw(address token, address recipient, uint128 amount)
    0x 0x [WITHDRAW_ARGS_SIZE] 0x 0x [CORE] gas call                        // [success]
}

#define macro PAY_ERC20_EXACT_IN(summand) = takes(5) returns(0) {
    // takes: [totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    PAY_ERC20(ADD(<summand>))                                               // [success, specifiedAmountBytes, specifiedAmountBits]
    LOCKED_RETURN()
}

#define macro PAY_ERC20_EXACT_OUT(summand) = takes(7) returns(6) {
    // takes: [totalCalculated, calculatedToken, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]

    PAY_ERC20(PUSH_OFFSET_AND(dup3, ADD(<summand>)))                        // [success, totalSpecified, specifiedToken, offset, specifiedAmountBytes, specifiedAmountBits]
}

#define macro ADD(summand) = {
    <summand> add
}

#define macro PUSH_OFFSET_AND(pushOffset, afterPush) = {
    <pushOffset> <afterPush>
}

#define macro PAY_ERC20(pushOffset) = takes(2) returns(1) {
    // takes: [amount, token]

    __RIGHTPAD(__FUNC_SIG("pay(address)")) 0x mstore                        // [amount, token]
    [PAY_AMOUNT_OFFSET] mstore                                              // [token]
    [PAY_TOKEN_OFFSET] mstore                                               // []

    <pushOffset>                                                            // [offset]
    calldataload                                                            // [transferFrom]
    [PAY_FROM_OFFSET] mstore                                                // []

    // IFlashAccountant#pay(address token)
    0x 0x [PAY_ARGS_SIZE] 0x 0x [CORE] gas call                             // [success]
}

#define macro NOT_LAST_SWAP_IS_TOKEN1(storeToken0, sqrtRatioLimitIsToken1, callArgs) = takes(13) returns(0) {
    // takes: [nextSpecifiedToken, offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    [SWAP_TOKEN1_OFFSET] mstore                                             // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    <storeToken0>                                                           // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    <sqrtRatioLimitIsToken1>                                                // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
    0x1 [SWAP_IS_TOKEN1_OFFSET] mstore                                      // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    CALL_SWAP(<callArgs>)                                                   // [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    JUMP_TO_NEXT_HOP(SWAP_DELTA0_OFFSET)
}

#define macro TOKEN0_NOT_IN_MEMORY() = takes(3) returns(3) {
    // takes: [offset, additionalHops, nextCalculatedToken]
    dup3 [SWAP_TOKEN0_OFFSET] mstore                                        // [offset, additionalHops, nextCalculatedToken]
}

#define macro CALL_SWAP(callArgs) = takes(0) returns(0) {
    // delta0 and delta1
    0x40                                                                    // [retSize]

    // Override only the non-zero address part of token0 because we don't clear it in the case that the next token is `codecopy`d.
    // We're also overriding the complete token1 and parts of the config offsets, but we always write to the full slot in the next iteration.
    [SWAP_TOKEN0_OFFSET_PACKED]                                             // [retOffset, retSize]

    <callArgs>                                                              // [argsOffset, argsSize, retOffset, retSize]

    // ICore#swap_611415377(address token0, address token1, bytes32 config, int128 amount, bool isToken1, uint96 sqrtRatioLimit, uint256 skipAhead) or IFlashAccountant#forward
    0x [CORE] gas call                                                      // [success]
    pop                                                                     // []
}

#define macro JUMP_TO_NEXT_HOP(deltaOffset) = takes(12) returns(0) {
    // takes: [offset, additionalHops, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    swap1                                                                   // [additionalHops, offset, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    // Negate the delta
    <deltaOffset> mload 0x sub                                              // [nextSpecifiedAmount, additionalHops, offset, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

    singleHopLbl jump
}