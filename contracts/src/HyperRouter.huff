/// @title HyperRouter
/// @author Die Herdplatte <https://github.com/die-herdplatte>
/// @notice A hyper gas-efficient, yet highly configurable, router for executing actions on Ekubo
///
/// Compiled with hnc 1.5.4 (rev: eef47bd4)
///
/// General comments:
/// - Offsets suffixed with "_PACKED" indicate that the offset marks the first byte in the input containing the non-padded data
/// - Constants aren't scoped, so we prefix them with appropriate identifiers where necessary to avoid mixing them up


/* Imports */
#include "lock.huff"
#include "locked.huff"

/* Function Interfaces */
#define function locked(uint256 id) nonpayable returns ()
#define function claimIntegrationFees(address[] tokens) nonpayable returns (uint256[] claimedAmounts)

#define error SlippageCheckFailed(uint256 calculatedAmount)
#define error ETHTransferFailed()
#define error CoreOnly()

#define constant SLOAD_SELECTOR = __FUNC_SIG("sload()")

#define constant MAX_ADDRESS = 0xffffffffffffffffffffffffffffffffffffffff
#define constant TWO_POW_8 = 0x100

#define constant WORD_SIZE = 0x20
#define constant HALFWORD_SIZE = [WORD_SIZE] / 0x2

#define constant SELECTOR_SIZE = 0x4
#define constant PACKED_SELECTOR_OFFSET = [WORD_SIZE] - [SELECTOR_SIZE]

#define constant ADDRESS_SIZE = 0x14
#define constant PACKED_ADDRESS_OFFSET = [WORD_SIZE] - [ADDRESS_SIZE]

#define constant LOCKED_CALL_TYPE_OFFSET = [SELECTOR_SIZE] + [WORD_SIZE]

// cast sig "claimIntegrationFees(address[])"
#define constant CLAIM_INTEGRATION_FEES_SELECTOR_FIRST_BYTE = 0xa3

#define constant UPDATE_SAVED_BALANCES_SELECTOR = __FUNC_SIG("updateSavedBalances(address,address,bytes32,int256,int256)")

// TODO Compute in Solidity?
/*
 * ATTENTION: This is a volatile value and may change even on minor modifications.
 * The reason for that seems to be that hnc doesn't insert jump and code tables in
 * the order that they appear in the source file but their first usage.
 * As of now, this offset includes the TOKENS, SAVE_DATA, and TRANSFER_DATA code tables and all jump tables.
 */
#define constant ROUTER_ADDRESS_END_OFFSET = 0x894

/* Constructor */
#define macro CONSTRUCTOR() = {
    // Copy runtime code into memory
    __codesize(CONSTRUCTOR)                                                 // [constructorSize]
    codesize sub                                                            // [runtimeSize]
    address                                                                 // [address, runtimeSize]
    [ROUTER_ADDRESS_END_OFFSET] dup3 sub                                    // [routerAddressOffset, address, runtimeSize]
    dup3 __codesize(CONSTRUCTOR) 0x                                         // [memOffset, constructorSize, runtimeSize, routerAddressOffset, address, runtimeSize]
    codecopy                                                                // [routerAddressOffset, address, runtimeSize]

    // Write router address to runtime code
    mstore                                                                  // [runtimeSize]

    0x return
}

/* Entry Point */
#define macro MAIN() = takes(0) returns(0) {
    0x calldataload                                                         // [firstWord]

    // The selector of "locked_6416899205(uint256 id)" and the first 224 bits of the
    // arguments are (in any practical case) 0, hence simplifying this check.
    // Note that the SDK would never generate calldata of this shape because it would
    // mean that a swap on a pool with token0 == token1 should happen.
    iszero lockedLbl jumpi                                                  // []

    0x calldataload                                                         // [firstWord]

    // Also won't collide with any generated calldata from the SDK due to the
    // first byte being either 0 or 1.
    0x byte                                                                 // [firstByte]
    [CLAIM_INTEGRATION_FEES_SELECTOR_FIRST_BYTE] eq lockClaimLbl jumpi      // []
        LOCK_SWAP()
    lockedLbl:                                                              // []
        CORE_CHECK()                                                        // []

        [LOCKED_CALL_TYPE_OFFSET] calldataload 0x byte                      // [callType]
        lockedClaimLbl jumpi                                                // []
            LOCKED_SWAP()
        lockedClaimLbl:                                                     // []
            LOCKED_CLAIM()
    lockClaimLbl:                                                           // []
        LOCK_CLAIM()
}

#define macro CORE_CHECK() = takes(0) returns(0) {
    caller [CORE] eq coreCallerLbl jumpi                                    // []
        __ERROR(CoreOnly) 0x mstore                                         // []
        [SELECTOR_SIZE] 0x revert
    coreCallerLbl:                                                          // []
}
