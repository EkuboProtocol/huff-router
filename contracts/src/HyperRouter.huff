            isToken1Last31Lbl:                                              // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            STORE_SWAP_ARGS_LAST_IS_TOKEN1(
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
            )                                                               // [swapCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            isToken1LastJoin31Lbl:                                          // [swapCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            SETTLE_BALANCES_IF_FINISHED_EXACT_OUT(multiHop3Lbl)

            notLastSwap31Lbl:                                               // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP(
                ORACLE_EXTENSION_CALLDATA_LENGTH,
                notLastSwapKnownToken31Lbl,
                notLastSwapUnknownTokenIsToken131Lbl,
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop3Lbl,
            )

            notLastSwapUnknownTokenIsToken131Lbl:                           // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_UNKNOWN_TOKEN_IS_TOKEN1(
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop3Lbl,
            )

            notLastSwapKnownToken31Lbl:                                     // [tokenInfo, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_KNOWN_TOKEN(
                notLastSwapKnownTokenIsToken131Lbl,
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop3Lbl,
            )

            notLastSwapKnownTokenIsToken131Lbl:                             // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_KNOWN_TOKEN_IS_TOKEN1(
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop3Lbl,
            )
        twammExtension3Lbl:                                                 // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            TWAMM_EXTENSION()
            STORE_SWAP_ARGS(
                notLastSwap32Lbl,
                TWAMM_EXTENSION_CALLDATA_LENGTH,
                isToken1Last32Lbl,
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                isToken1LastJoin32Lbl,
            )

            isToken1Last32Lbl:                                              // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            STORE_SWAP_ARGS_LAST_IS_TOKEN1(
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
            )                                                               // [swapCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            isToken1LastJoin32Lbl:                                          // [swapCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            SETTLE_BALANCES_IF_FINISHED_EXACT_OUT(multiHop3Lbl)

            notLastSwap32Lbl:                                               // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP(
                TWAMM_EXTENSION_CALLDATA_LENGTH,
                notLastSwapKnownToken32Lbl,
                notLastSwapUnknownTokenIsToken132Lbl,
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop3Lbl,
            )

            notLastSwapUnknownTokenIsToken132Lbl:                           // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_UNKNOWN_TOKEN_IS_TOKEN1(
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop3Lbl,
            )

            notLastSwapKnownToken32Lbl:                                     // [tokenInfo, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_KNOWN_TOKEN(
                notLastSwapKnownTokenIsToken132Lbl,
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop3Lbl,
            )

            notLastSwapKnownTokenIsToken132Lbl:                             // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_KNOWN_TOKEN_IS_TOKEN1(
                STORE_SQRT_RATIO_LIMIT_FROM_CALLDATA(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop3Lbl,
