/// @title HyperRouter
/// @author Die Herdplatte <https://github.com/die-herdplatte>
/// @notice A hyper gas-efficient, yet highly configurable, router for executing multiMultiHopSwaps on Ekubo pools

// Compiled with hnc 1.2.0 (rev: 97a6d380)

#define error SlippageCheckFailed(int128)
#define error ETHTransferFailed()
#define error CoreOnly()

#define constant BITS_PER_BYTE = 0x8
#define constant BITS_PER_WORD = 0x100

#define constant MIN_SQRT_RATIO = 0x400065a8177fae27
#define constant MAX_SQRT_RATIO = 0xffff9a5889f795069a41a8a3

#define constant MINUS_ONE = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

#define constant ADDRESS_LENGTH = 0x14
#define constant INTEGRATION_FEE_LENGTH = 0x16
#define constant ADDRESS_PLUS_INTEGRATION_FEE_LENGTH = 0x2a

// ILocker#locked(uint256 id) input offsets
#define constant LOCKED_FIRST_WORD_OFFSET = 0x27 // Includes the selector, locker ID, 2 bytes padding, and `withRecipient` (which isn't used in LOCKED())
#define constant LOCKED_CALCULATED_AMOUNT_THRESHOLD_OFFSET = 0x2e // Offset of the first dynamic piece of data

// Calldata lengths of supported extensions
#define constant BASE_EXTENSION_CALLDATA_LENGTH = 0xe
#define constant ORACLE_EXTENSION_CALLDATA_LENGTH = 0x1
#define constant TWAMM_EXTENSION_CALLDATA_LENGTH = 0x9
#define constant MEV_RESIST_EXTENSION_CALLDATA_LENGTH = 0xe
#define constant UNKNOWN_EXTENSION_CALLDATA_LENGTH = 0x22

// ICore#swap_611415377(address token0, address token1, bytes32 config, int128 amount, bool isToken1, uint96 sqrtRatioLimit, uint256 skipAhead) and IFlashAccountant#forward (for MEV-resist) input offsets
#define constant SWAP_TOKEN0_OFFSET = 0x24
#define constant SWAP_TOKEN0_OFFSET_PACKED = 0x30
#define constant SWAP_TOKEN1_OFFSET = 0x44
#define constant SWAP_CONFIG_OFFSET = 0x64
#define constant SWAP_AMOUNT_OFFSET = 0x84
#define constant SWAP_IS_TOKEN1_OFFSET = 0xa4
#define constant SWAP_SQRT_RATIO_LIMIT_OFFSET = 0xc4
#define constant SWAP_SQRT_RATIO_LIMIT_PACKED_OFFSET = 0xd8
#define constant SWAP_SKIP_AHEAD_OFFSET = 0xe4

// ICore#swap_611415377(address token0, address token1, bytes32 config, int128 amount, bool isToken1, uint96 sqrtRatioLimit, uint256 skipAhead) and IFlashAccountant#forward (for MEV-resist) output offsets
#define constant SWAP_DELTA0_OFFSET = 0x30
#define constant SWAP_DELTA1_OFFSET = 0x50

// The lowest offset we don't touch while swapping (i.e. not counting the settlement phase)
#define constant MAX_ARGS_OFFSET = 0x104

// ICore#save(address owner, address token0, address token1, bytes32 salt, uint128 amount0, uint128 amount1) input offsets
#define constant SAVE_OWNER_PACKED_OFFSET = 0x10
#define constant SAVE_TOKEN0_OFFSET = 0x24
#define constant SAVE_AMOUNT0_OFFSET = 0x84
#define constant SAVE_AMOUNT1_OFFSET = 0xa4
#define constant SAVE_ARGS_SIZE = 0xc4

// IFlashAccountant#withdraw(address token, address recipient, uint128 amount) input offsets
#define constant WITHDRAW_TOKEN_OFFSET = 0x4
#define constant WITHDRAW_RECIPIENT_PACKED_OFFSET = 0x30
#define constant WITHDRAW_AMOUNT_OFFSET = 0x44
#define constant WITHDRAW_ARGS_SIZE = 0x64

// IFlashAccountant#pay(address token) input offsets
#define constant PAY_TOKEN_OFFSET = 0x4
#define constant PAY_AMOUNT_OFFSET = 0x24
#define constant PAY_FROM_OFFSET = 0x44
#define constant PAY_ARGS_SIZE = 0x64

// IPayer#payCallback(uint256 id, address token) input offsets
#define constant PAY_CALLBACK_TOKEN_OFFSET = 0x24
#define constant PAY_CALLBACK_AMOUNT_OFFSET = 0x44
#define constant PAY_CALLBACK_FROM_OFFSET = 0x64

// IERC20#transfer(address to, uint256 amount) input offsets
#define constant TRANSFER_AMOUNT_OFFSET = 0x24
#define constant TRANSFER_ARGS_SIZE = 0x44

// IERC20#transferFrom(address from, address to, uint256 amount) input offsets
#define constant TRANSFER_FROM_FROM_OFFSET = 0x4
#define constant TRANSFER_FROM_TO_OFFSET = 0x24
#define constant TRANSFER_FROM_AMOUNT_OFFSET = 0x44
#define constant TRANSFER_FROM_ARGS_SIZE = 0x64

#define constant RETURN_DATA_CALCULATED_AMOUNT_OFFSET = 0xc4
#define constant RETURN_DATA_INTEGRATION_FEE_OFFSET = 0xe4

/*
 * ATTENTION: This is a volatile value and may change even on minor modifications.
 * The reason for that seems to be that hnc doesn't insert jump and code tables in
 * the order that they appear in the source file but their first usage.
 * As of now, this offset includes the TOKENS, SAVE_DATA, and TRANSFER_DATA code tables and all jump tables.
 */
#define constant ROUTER_ADDRESS_END_OFFSET = 0x878

#define macro CONSTRUCTOR() = {
    // Copy runtime code into memory
    __codesize(CONSTRUCTOR)                                                 // [constructorSize]
    codesize sub                                                            // [runtimeSize]
    address                                                                 // [address, runtimeSize]
    [ROUTER_ADDRESS_END_OFFSET] dup3 sub                                    // [routerAddressOffset, address, runtimeSize]
    dup3 __codesize(CONSTRUCTOR) 0x                                         // [memOffset, constructorSize, runtimeSize, routerAddressOffset, address, runtimeSize]
    codecopy                                                                // [routerAddressOffset, address, runtimeSize]

    // Write router address to runtime code
    mstore                                                                  // [runtimeSize]

    0x return
}

#define macro MAIN() = takes(0) returns(0) {
    0x calldataload dup1                                                    // [firstWord, firstWord]

    // Not only the function selector, but also the first 224 bits of the
    // arguments (which is the locker id and always zero in any practical case)
    __RIGHTPAD(__FUNC_SIG("locked(uint256)"))                               // [lockedFirstWord, firstWord, firstWord]

    eq lockedLbl jumpi                                                      // [firstWord]

    // Same approach for payCallback which also includes the locker id
    __RIGHTPAD(__FUNC_SIG("payCallback(uint256,address)"))                  // [payCallbackFirstWord, first]

    eq payCallbackLbl jumpi                                                 // []
        LOCK()
    lockedLbl:                                                              // [firstWord]
        pop                                                                 // []
        LOCKED()
    payCallbackLbl:                                                         // []
        PAY_CALLBACK()
}

/// @notice Entrypoint of the router which prepares and executes the call to IFlashAccountant#lock.
///
/// `withRecipient` (1 byte `bool`)
/// Whether the swap output (after possibly deducting integration fees) should be sent
/// to an address different from the caller.
///
/// `specifiedAmountBytes` (1 byte unsigned integer, <= 16)
/// The length of the `specifiedAmount`s of each multihop swap in bytes.
///
/// `calculatedAmountThresholdBytes` (1 byte `uint8`, <= 32)
/// The length of `calculatedAmountThreshold` in bytes.
///
/// `specifiedTokenInfo` (1 byte)
/// Describes the input token of the multihop swaps:
/// 0x00 - 0xfe := Token address stored at the given index in the `TOKENS` table
/// 0xff := Token address is passed in the calldata
///
/// `calculatedTokenInfo` (1 byte)
/// Analogous to `specifiedTokenInfo`.
///
/// `additionalMultiHopSwaps` (1 byte `uint8`)
/// How many more multihop swaps are encoded besides the mandotary one.
///
/// `withIntegrationFee` (1 byte `bool`)
/// Whether a share of the swap output will be distributed to a given integrator.
///
/// `withSqrtRatioLimit` | `isExactOut` (1 bit `bool` | 1 bit `bool`, left-padded)
/// Whether swaps are encoded with a custom sqrt ratio limit and
/// whether the swap is exact out.
///
/// `calculatedAmountThreshold` (variable length unsigned integer, up to 32 bytes)
/// How much the last swaps of each multiHopSwap need to return in total at minimum for the call to succeed.
///
/// `specifiedTokenAddress` (20 bytes `address`, optional as per `specifiedTokenInfo`)
/// The address of the input token of the multihop swaps.
///
/// `calculatedTokenAddress` (20 bytes `address`, optional as per `calculatedTokenInfo`)
/// Analogous to `specifiedTokenAddress`.
///
/// Per multihop swap:
///
/// `specifiedAmount` (variable length unsigned integer up to 16 bytes, determined by `specifiedAmountBytes`)
/// The specified amount of the first swap.
///
/// `additionalSwaps` (1 byte unsigned integer)
/// How many more swaps are encoded in this multihop swap besides the mandatory one.
///
/// Per swap:
///
/// `extensionInfo` (1 byte)
/// Describes the extension of this hop's pool:
/// 0x00 := Base extension
/// 0x01 := Oracle extension
/// 0x02 := TWAMM extension
/// 0x03 := MEV-resist extension
/// 0x04 := Pool config is passed in the calldata
///
/// `skipAhead` (1 byte `uint8`, optional as per `extensionInfo`)
/// For base, MEV-resist, and unknown extensions, this is an `uint8`. Otherwise non-existent.
///
/// `configInfo` (variable)
/// Depending on `extensionInfo`:
/// Base => fee (8 bytes) | tick spacing (4 bytes)
/// Oracle => empty
/// TWAMM => fee (8 bytes)
/// MEV-resist => fee (8 bytes) | tick spacing (4 bytes)
/// Else => complete config (32 bytes)
///
/// `tokenInfo` (1 byte, for all but the last swap in a multihop swap)
/// Describes the output token of this hop:
/// [0x00, 0xfe] := Token address stored at the given index in the `TOKENS` table
/// 0xff := Token address is passed in the calldata
///
/// `tokenAddress` (20 bytes `address`, optional as per `tokenInfo`, also for all but the last swap in a multihop swap)
/// The address of the output token of this hop.
///
/// `sqrtRatioLimit` (12 bytes `uint96`, optional as per `withSqrtRatioLimit`)
/// The price limit of the swap.
///
/// After the swap data:
///
/// `feeShare` | `feeRecipient` (2 bytes 0.16 fixed point number | 20 bytes `address`, optional as per `withIntegrationFee`)
/// The integrator address as well as the share that the integrator receives from the swap output.
/// Fees are `save`d for the `feeRecipient` in Core.
///
/// `recipient` (20 bytes `address`, optional as per `withRecipient`)
/// Adress of the account that receives the swap output (after possibly deducting integration fees).
/// If `withRecipient === false`, this will be filled in by LOCK().
#define macro LOCK() = takes(0) returns(0) {
    // Load lock() selector and router address in one `codecopy`
    __tablesize(LOCK_SIG_AND_ROUTER_ADDRESS)                                // [tableSize]
    __tablestart(LOCK_SIG_AND_ROUTER_ADDRESS)                               // [tableStart, tableSize]
    0x codecopy                                                             // []
    0x4 mload                                                               // [routerAddress]

    // Load `withRecipient`
    0x calldataload 0x byte                                                 // [withRecipient, routerAddress]

    // If `withRecipient == true`, the recipient is already stored in the calldata
    withRecipientLbl jumpi                                                  // [routerAddress]
        caller                                                              // [caller, routerAddress]

        // Since the minimum `calldatasize` is 10 bytes (`withRecipient`, `specifiedAmountBytes`, `calculatedAmountThresholdBytes`,
        // `withIntegrationFee`, `specifiedTokenInfo`, `calculatedTokenInfo`, `additionalMultiHopSwaps`,
        // `withSqrtRatioLimit` | `isExactOut`, `additionalSwaps`, `extensionInfo`),
        // we designate 2 bytes between the selector and the calldata as padding to ensure never overwriting the selector.
        // Therefore, 4 bytes selector - 12 bytes packed `address` offset + 2 bytes padding = -6 bytes offset from `calldatasize`
        0x6 calldatasize sub                                                // [callerOffset, caller, routerAddress]
        mstore                                                              // [routerAddress]

        MAYBE_STORE_TRANSFER_FROM(
            STORE_RECIPIENT(address),
            STORE_RECIPIENT(caller),
            0x1a,
            0x3a,
        )
    withRecipientLbl:                                                       // [routerAddress]
        MAYBE_STORE_TRANSFER_FROM(
            NO_OP(),
            NO_OP(),
            0x6,
            0x26,
        )
}

#define macro MAYBE_STORE_TRANSFER_FROM(maybeStoreRecipientDelegatecall, maybeStoreRecipientNoDelegatecall, additionalArgsSizeDelegate, additionalArgsSizeNoDelegate) = takes(1) returns(0) {
    // takes: [routerAddress]

    address eq noDelegateCallLbl jumpi                                      // []
        <maybeStoreRecipientDelegatecall>                                   // []

        LOCK_END(<additionalArgsSizeDelegate>)
    noDelegateCallLbl:                                                      // []
        <maybeStoreRecipientNoDelegatecall>                                 // []

        // Store ABI-encoded caller address after the end of the calldata
        caller <additionalArgsSizeDelegate> calldatasize add mstore         // []

        LOCK_END(<additionalArgsSizeNoDelegate>)
}

#define macro STORE_RECIPIENT(recipient) = takes(0) returns(0) {
    <recipient>                                                             // [recipient]

    // Since the minimum `calldatasize` is 10 bytes (`withRecipient`, `specifiedAmountBytes`, `calculatedAmountThresholdBytes`,
    // `withIntegrationFee`, `specifiedTokenInfo`, `calculatedTokenInfo`, `additionalMultiHopSwaps`,
    // `withSqrtRatioLimit` | `isExactOut`, `additionalSwaps`, `extensionInfo`),
    // we designate 2 bytes between the selector and the calldata as padding to ensure never overwriting the selector.
    // Therefore, 4 bytes selector - 12 bytes packed `address` offset + 2 bytes padding = -6 bytes offset from `calldatasize`
    0x6 calldatasize sub                                                    // [recipientOffset, recipient]
    mstore                                                                  // []
}

#define macro LOCK_END(additionalArgsSize) = takes(0) returns(0) {
    // Copy calldata unchanged after the selector and the 2 bytes of padding
    calldatasize 0x 0x6 calldatacopy                                        // []

    0x 0x                                                                   // [retOffset, retSize]
    calldatasize <additionalArgsSize> add                                   // [argsSize, retOffset, retSize]

    // IFlashAccountant#lock()
    0x 0x [CORE] gas call                                                   // [success]

    returndatasize 0x 0x returndatacopy                                     // [success]

    successLbl jumpi                                                        // []
        returndatasize 0x revert
    successLbl:                                                             // []
        returndatasize 0x return
}

/// @notice Ekubo Core callback, executing a multiMultiHopSwap.
///
/// In addition to the calldata described in LOCK():
///
/// `transferFrom` (32 bytes ABI-encoded `address`, optional as determined in LOCK(), non-zero)
/// If this is called via a `delegatecall` (checked via `routerAddress != address(this)`), the
/// swap inputs are transferred from the delegating contract and this value does not exist.
/// Otherwise, approvals to this contract from the caller are consumed to settle the debt.
#define macro LOCKED() = takes(0) returns(0) {
    CORE_CHECK()                                                            // []

    [LOCKED_FIRST_WORD_OFFSET] calldataload                                 // [firstWord]

    // Parse `specifiedAmountBytes`
    dup1 0x byte                                                            // [specifiedAmountBytes, firstWord]

    // Parse `calculatedAmountThresholdBytes` and compute `calculatedAmountThreshold`
    [LOCKED_CALCULATED_AMOUNT_THRESHOLD_OFFSET]                             // [offset, specifiedAmountBytes, firstWord]
    dup3 0x1 byte                                                           // [calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    dup2 calldataload dup2                                                  // [calculatedAmountThresholdBytes, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    [BITS_PER_BYTE] mul                                                     // [calculatedAmountThresholdBits, calculatedAmountThresholdWord, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    [BITS_PER_WORD] sub shr                                                 // [calculatedAmountThreshold, calculatedAmountThresholdBytes, offset, specifiedAmountBytes, firstWord]
    swap2                                                                   // [offset, calculatedAmountThresholdBytes, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    add                                                                     // [offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]

    // Parse `specifiedTokenInfo` and recover `specifiedToken`
    0x                                                                      // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup5 0x2 byte                                                           // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup1 0xff gt specifiedKnownLbl jumpi                                    // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        pop                                                                 // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [ADDRESS_LENGTH]                                                    // [addressLength, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        dup3 calldataload 0x60 shr                                          // [specifiedToken, addressLength, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap3                                                               // [offset, addressLength, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        add                                                                 // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        specifiedJoinLbl jump
    specifiedKnownLbl:                                                      // [specifiedTokenInfo, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        STORE_KNOWN_TOKEN_AT_TOKEN0_OFFSET()                                // [totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        LOAD_KNOWN_TOKEN_FROM_TOKEN0_OFFSET()                               // [specifiedToken, totalSpecified, offset, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap2                                                               // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    specifiedJoinLbl:                                                       // [offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]

    // Parse `calculatedTokenInfo` and recover `calculatedToken`
    0x                                                                      // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup7 0x3 byte                                                           // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    dup1 0xff gt calculatedKnownLbl jumpi                                   // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        pop                                                                 // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        [ADDRESS_LENGTH]                                                    // [addressLength, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        dup3 calldataload 0x60 shr                                          // [calculatedToken, addressLength, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap3                                                               // [offset, addressLength, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        add                                                                 // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        calculatedJoinLbl jump
    calculatedKnownLbl:                                                     // [calculatedTokenInfo, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        STORE_KNOWN_TOKEN_AT_TOKEN0_OFFSET()                                // [totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        LOAD_KNOWN_TOKEN_FROM_TOKEN0_OFFSET()                               // [calculatedToken, totalCalculated, offset, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
        swap2                                                               // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    calculatedJoinLbl:                                                      // [offset, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, firstWord]
    swap7                                                                   // [firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `additionalMultiHopSwaps`
    dup1 0x4 byte 0x1 add                                                   // [remainingMultiHopSwaps, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `withIntegrationFee`
    dup2 0x5 byte                                                           // [withIntegrationFee, remainingMultiHopSwaps, firstWord, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    swap2                                                                   // [firstWord, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Parse `withSqrtRatioLimit | isExactOut`
    0x6 byte                                                                // [withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    // Load jumptable into memory & take jump
    __tablesize(CONFIG_TABLE) __tablestart(CONFIG_TABLE)                    // [tableStart, tableSize, withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x codecopy                                                             // [withSqrtRatioLimit | isExactOut, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
    0x20 mul mload jump                                                     // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]

    /*
     * The following section is so large because of how hnc presumably tracks labels in some cases:
     * Instead of tracking labels per context, it seems to track them globally,
     * therefore making calls to the same macro but with different arguments impossible
     * if the macro also includes jump labels (this would lead to using the same `jumpdest`
     * in every invocation).
     *
     * Therefore, we have to split the control flow at every point where a label (i.e. `jumpdest`)
     * should be inserted and insert it at the top level to ensure its global uniqueness.
     *
     * I couldn't reproduce this behavior in an isolated example, so it might be unintended behavior.
     */

    noSqrtRatioExactInLbl:                                                  // [remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
        __tablesize(EXTENSION0_TABLE) __tablestart(EXTENSION0_TABLE)        // [tablestart, tablesize, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, offset]
        SWAP_PRELUDE()                                                      // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        multiHop0Lbl:                                                       // [offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        MULTI_HOP(NO_OP())                                                  // [nextSpecifiedAmount, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

        singleHop0Lbl:                                                      // [nextSpecifiedAmount, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
        SINGLE_HOP()

        baseExtension0Lbl:                                                  // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            BASE_EXTENSION()
            STORE_SWAP_ARGS(
                notLastSwap00Lbl,
                BASE_EXTENSION_CALLDATA_LENGTH,
                isToken1Last00Lbl,
                STORE_MIN_SQRT_RATIO(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                isToken1LastJoin00Lbl,
            )

            isToken1Last00Lbl:                                              // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            STORE_SWAP_ARGS_LAST_IS_TOKEN1(
                STORE_MAX_SQRT_RATIO(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
            )                                                               // [swapCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]

            isToken1LastJoin00Lbl:                                          // [swapCalculated, totalCalculated, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, offset, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            SETTLE_BALANCES_IF_FINISHED_EXACT_IN(multiHop0Lbl)

            notLastSwap00Lbl:                                               // [additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP(
                BASE_EXTENSION_CALLDATA_LENGTH,
                notLastSwapKnownToken00Lbl,
                notLastSwapUnknownTokenIsToken100Lbl,
                STORE_MIN_SQRT_RATIO(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop0Lbl,
            )

            notLastSwapUnknownTokenIsToken100Lbl:                           // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_UNKNOWN_TOKEN_IS_TOKEN1(
                STORE_MAX_SQRT_RATIO(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop0Lbl,
            )

            notLastSwapKnownToken00Lbl:                                     // [tokenInfo, offset, additionalSwaps, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_KNOWN_TOKEN(
                notLastSwapKnownTokenIsToken100Lbl,
                STORE_MIN_SQRT_RATIO(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop0Lbl,
            )

            notLastSwapKnownTokenIsToken100Lbl:                             // [nextSpecifiedToken, offset, additionalSwaps, nextCalculatedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            NOT_LAST_SWAP_KNOWN_TOKEN_IS_TOKEN1(
                STORE_MAX_SQRT_RATIO(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                singleHop0Lbl,
            )
        oracleExtension0Lbl:                                                // [swapWord, additionalSwaps, offset, nextSpecifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            ORACLE_EXTENSION()
            STORE_SWAP_ARGS(
                notLastSwap01Lbl,
                ORACLE_EXTENSION_CALLDATA_LENGTH,
                isToken1Last01Lbl,
                STORE_MIN_SQRT_RATIO(),
                PUSH_SWAP_CALL_OFFSET_AND_LENGTH(),
                isToken1LastJoin01Lbl,
            )

            isToken1Last01Lbl:                                              // [nextSpecifiedToken, nextCalculatedToken, offset, specifiedToken, remainingMultiHopSwaps, withIntegrationFee, totalCalculated, calculatedToken, totalSpecified, specifiedToken, calculatedAmountThreshold, specifiedAmountBytes, specifiedAmountBits]
            STORE_SWAP_ARGS_LAST_IS_TOKEN1(
